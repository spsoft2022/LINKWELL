@{
    Layout = "_FloorLayout"; ;
}
<style>
    #floorHeader {
        height: 70px;
        background: #0d6efd;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 25px;
        font-size: 26px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    #instructionContainer {
        height: calc(100% - 70px); /* Remaining screen */
        overflow: hidden;
        padding: 20px;
    }

</style>
<div id="floorHeader">
    <span id="stationName">Loading...</span>
    <span id="modelName">Loading...</span>
</div>
<div id="instructionContainer" style="height:100vh; overflow:auto; padding:15px; background:#f5f7fa">
    <div id="instructionArea">Loading instructions...</div>
</div>
<script type="text/javascript">

    const stationId = "@ViewBag.StationId";
    const modelId = "@ViewBag.ModelId";
    const version = "@ViewBag.VersionNo";


    $(document).ready(function () {



        const container = document.getElementById('instructionContainer');

        // ================= HOVER PAUSE =================
        let paused = false;

        container.onmouseover = () => paused = true;
        container.onmouseleave = () => paused = false;
        let scrollSpeed = 1;

        // ================= AUTO SCROLL =================
            function autoScroll() {

            const maxScroll = container.scrollHeight - container.clientHeight;

            container.scrollTop += scrollSpeed;

            if (container.scrollTop >= maxScroll) {
            container.scrollTop = 0;
            }
            }

        // ================= LOAD FLOOR PREVIEW =================
        $.get(`/api/workinstructions/preview?modelId=${modelId}&stationId=${stationId}${version ? `&versionNo=${version}` : ''}`, function (res) {

            console.log(res); // Debug in browser console

            if (!res || !res.success) {

                $("#instructionArea").html(
                    "<div class='alert alert-danger'>Failed to load preview</div>"
                );
                return;
            }

            // ===== ALWAYS SET HEADER =====
            $("#stationName").text(res.stationName || "Station");
            $("#modelName").text(res.modelName || "Model");

            // ===== CHECK DATA =====
            if (!res.data || res.data.length === 0) {

                $("#instructionArea").html(
                    "<div class='alert alert-warning'>No instructions configured</div>"
                );
                return;
            }

            let html = "";

            res.data.forEach(x => {

                html += `
                    <div class="border rounded p-3 mb-3 bg-white shadow-sm">
                        ${x.htmlContent}
                    </div>
                `;
            });

            $("#instructionArea").html(html);

            // ===== PREVENT MULTIPLE TIMERS =====
            if (window.floorScrollTimer)
                clearInterval(window.floorScrollTimer);

            // ===== START AUTO SCROLL =====
            window.floorScrollTimer = setInterval(() => {

                if (!paused)
                    autoScroll();

            }, 30);

        }).fail(function () {

            $("#instructionArea").html(
                "<div class='alert alert-danger'>Server connection failed</div>"
            );
        });

    });
</script>

