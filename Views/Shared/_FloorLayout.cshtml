<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>

    <link href="~/lib/support/bootstrap.min.css" rel="stylesheet">
    <link href="~/lib/support/toastr.min.css" rel="stylesheet">
    <link href="~/lib/support/jqx.base.css" rel="stylesheet" />
    <link href="~/lib/support/quill.snow.css" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- jQuery FIRST -->
    <script src="~/lib/support/jquery.min.js"></script>

    <!-- Bootstrap WITH Popper -->
    <script src="~/lib/support/bootstrap.bundle.min.js"></script>

    <!-- jqx -->
    <script src="~/lib/support/jqx-all.js"></script>


    <!-- toastr -->
    <script src="~/lib/support/toastr.min.js"></script>

    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden !important;
        }

        body {
            background: #fff;
            font-size: 22px;
        }

        /* Instruction cards */
        .instruction-block {
            border: 2px solid #ddd;
            padding: 20px;
            margin-bottom: 25px;
            border-radius: 10px;
        }

        .instruction-title {
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        /* Main scroll container */
        #instructionContainer {
            height: 100%;
            width: 100%;
            overflow: hidden; /* IMPORTANT: no scrollbar */
            padding: 20px;
            background: white;
            box-sizing: border-box;
        }


    </style>
</head>
<body>
    @RenderBody()

    <script src="/lib/jquery/dist/jquery.min.js"></script>
</body>
</html>
