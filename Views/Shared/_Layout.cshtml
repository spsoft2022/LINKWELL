@using System.Security.Claims

@{
    var isLoggedIn = User.Identity.IsAuthenticated;
    var fullName = User.Identity.Name;
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"] - Linkwell</title>
    <meta name="viewport" content="width=device-width" />

    <link href="~/lib/support/bootstrap.min.css" rel="stylesheet">
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">


    <link href="~/lib/support/toastr.min.css" rel="stylesheet">

    <link href="~/lib/support/jqx.base.css" rel="stylesheet" />
    
    <script src="~/lib/support/jquery.min.js"></script>
    <script src="~/lib/support/bootstrap.bundle.min.js"></script>
    <script src="~/lib/support/jqx-all.js"></script>

    <link href="~/lib/support/quill.snow.css" rel="stylesheet">
    <script src="~/lib/support/quill.min.js"></script>

    <script src="~/lib/support/toastr.min.js"></script>

    <style>

          body {
            overflow-x: hidden;
        }

        .app-shell {
            min-height: 100vh;
        }

        /* ================= SIDEBAR ================= */

        .sidebar {
            width: 219px;
            background: #FFFFFF;
            border-right: 1px solid #ddd;
            transition: width 0.25s ease;
            overflow: hidden;
        }

            .sidebar.collapsed {
                width: 76px;
            }

   

        .brand-short {
            max-width: 40px;
            display: none;
        }

        .sidebar.collapsed .brand-full {
            display: none;
        }

        .sidebar.collapsed .brand-short {
            display: inline;
        }

        .menu-section {
            margin-top: 20px;
        }

        .menu-title {
            font-size: 12px;
            text-transform: uppercase;
            color: #888;
            padding: 8px 16px;
            font-weight: 600;
        }

        .sidebar.collapsed .menu-title {
            display: none;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            margin: 4px 8px;
            border-radius: 6px;
            color: #444;
            text-decoration: none;
            font-size: 14px;
            transition: all 0.2s ease;
        }

            .menu-link:hover {
                background: #e9ecef;
                color: #000;
            }

            .menu-link.active {
                background: #fff;
                border-left: 4px solid #ff6b00;
                font-weight: 600;
            }

        .menu-icon {
            font-size: 18px;
            min-width: 22px;
            text-align: center;
        }

        .sidebar.collapsed .menu-link {
            justify-content: center;
        }

        .sidebar.collapsed .menu-text {
            display: none;
        }


        .topbar {
            height: 60px;
            background: linear-gradient(to right, #2c2c2c, #1f1f1f);
            color: white;
            border-bottom: 1px solid #333;
        }


        #userMenuBtn:hover {
            background-color: #0b5ed7;
        }

        .content-area {
            min-width: 0;
            overflow-x: hidden;
        }

        #toast-container {
            z-index: 999999 !important;
        }   


        .dropdown-menu {
            min-width: 180px;
        }


        .sidebar-logo {
            background: #FFFFFF;
            background: #eeeeee; /* match design */
            text-align: center;
            height:60px;
            border-bottom: 1px solid #ddd;
            padding: 20px 0;
            justify-content: center;
            align-items: center;
        }

        .bodyback{
            color: #D9D9D9;
        }

            .sidebar-logo img {
                width:179px;
            height: auto;
            object-fit: contain;
            transition: all 0.25s ease;
            }

        /* Collapsed Mode */
        .sidebar.collapsed .sidebar-logo img {
            max-width: 42px;
        }
    </style>
</head>

<body>

    @if (isLoggedIn)
    {
        <!-- LOGGED-IN LAYOUT -->
        <div class="d-flex app-shell">

            <!-- ================= SIDEBAR ================= -->
            <aside id="sidebar" class="sidebar">

                <!-- Logo -->
                <div class="sidebar-logo">
                    <img src="~/images/logo-full.png" class="brand-full" />
                    <img src="~/images/logo-icon.png" class="brand-short" />
                </div>

                <!-- DASHBOARDS -->
                <div class="menu-section">
                    <div class="menu-title">Dashboards</div>

                    <a asp-controller="Dashboard" asp-action="Index" class="menu-link">
                        <i class="bi bi-speedometer2 menu-icon"></i>
                        <span class="menu-text">Dashboard</span>
                    </a>
                </div>

                <!-- MENU -->
                <div class="menu-section">
                    <div class="menu-title">Menu</div>

                    <a asp-controller="Category" asp-action="Index" class="menu-link">
                        <i class="bi bi-tags menu-icon"></i>
                        <span class="menu-text">Category</span>
                    </a>

                    <a asp-controller="Model" asp-action="Index" class="menu-link">
                        <i class="bi bi-box menu-icon"></i>
                        <span class="menu-text">Models</span>
                    </a>

                    <a asp-controller="Station" asp-action="Index" class="menu-link">
                        <i class="bi bi-building menu-icon"></i>
                        <span class="menu-text">Stations</span>
                    </a>

                    <a asp-controller="Model" asp-action="AssignStation" class="menu-link">
                        <i class="bi bi-diagram-3 menu-icon"></i>
                        <span class="menu-text">Assign Stations</span>
                    </a>
                </div>

                <!-- MANUALS -->
                <div class="menu-section">
                    <div class="menu-title">Manuals</div>

                    <a asp-controller="WorkInstruction" asp-action="AddInstructions" class="menu-link">
                        <i class="bi bi-journal-text menu-icon"></i>
                        <span class="menu-text">Instructions</span>
                    </a>
                </div>

                <!-- HELP -->
                <div class="menu-section">
                    <div class="menu-title">Help</div>

                    <a asp-controller="Account" asp-action="Profile" class="menu-link">
                        <i class="bi bi-person menu-icon"></i>
                        <span class="menu-text">Profile</span>
                    </a>
                </div>

            </aside>

            <!-- ================= RIGHT SIDE ================= -->
            <div class="flex-grow-1 d-flex flex-column content-area">

                <!-- HEADER -->
                <div class="topbar d-flex align-items-center justify-content-between px-4">

                    <div class="d-flex align-items-center gap-3">

                        <button id="toggleSidebar"
                                class="btn btn-link text-white p-0 border-0"
                                type="button">
                            <i class="bi bi-list fs-4"></i>
                        </button>

                        <a href="javascript:history.back()" class="text-white text-decoration-none">
                            <i class="bi bi-arrow-left fs-5"></i>
                        </a>

                        <span class="fs-5 fw-semibold text-white">
                            @ViewData["Title"]
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-3">

                        <div class="text-end text-white">
                            <div class="fw-semibold">@fullName</div>
                            <small class="text-warning">Login as @role</small>
                        </div>

                        <div class="dropdown">
                            <div id="userMenuBtn"
                                 class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                                 data-bs-toggle="dropdown"
                                 style="width:40px;height:40px;cursor:pointer;">
                                <i class="bi bi-person-fill"></i>
                            </div>

                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Account"
                                       asp-action="Profile">
                                        Profile
                                    </a>
                                </li>

                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <a class="dropdown-item text-danger"
                                       asp-controller="Account"
                                       asp-action="Logout">
                                        Logout
                                    </a>
                                </li>
                            </ul>
                        </div>

                    </div>
                </div>

                <!-- CONTENT -->
                <div class="bg-light flex-grow-1 p-3 bodyback">
                    @RenderBody()
                </div>

                <!-- FOOTER -->
                <div class="bg-light text-center p-2 border-top">
                    © @DateTime.Now.Year Linkwell Electronics
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- LOGIN PAGE ONLY -->
        @RenderBody()
    }

    <script>

        $(function () {

            /* ================= Sidebar ================= */

            const sidebar = $("#sidebar");
            const toggleBtn = $("#toggleSidebar");
            const menuLinks = sidebar.find(".menu-link");

            function applySidebarState(isCollapsed) {
                sidebar.toggleClass("collapsed", isCollapsed);

                menuLinks.each(function () {
                    const menuText = $(this).data("menu-text");
                    $(this).attr("title", isCollapsed ? menuText : "");
                });

                requestAnimationFrame(refreshGridLayouts);
                setTimeout(refreshGridLayouts, 150);
            }

            // Restore state
            const savedState = localStorage.getItem("sidebarState") === "collapsed";
            applySidebarState(savedState);

            // Toggle
            toggleBtn.on("click", function () {
                const newState = !sidebar.hasClass("collapsed");
                applySidebarState(newState);
                localStorage.setItem("sidebarState",
                    newState ? "collapsed" : "expanded");
            });

            /* ================= Active Menu ================= */

            const currentUrl = window.location.pathname.toLowerCase();

            $(".menu-link").each(function () {
                const linkUrl = $(this).attr("href")?.toLowerCase();
                if (linkUrl && currentUrl.includes(linkUrl)) {
                    $(".menu-link").removeClass("active");
                    $(this).addClass("active");
                }
            });

            /* ================= Toastr ================= */

            toastr.options = {
                closeButton: true,
                progressBar: true,
                positionClass: "toast-top-right",
                timeOut: "3000"
            };

            @if (TempData["success"] != null)
            {
                    <text>toastr.success('@TempData["success"]');</text>
            }

            @if (TempData["error"] != null)
            {
                    <text>toastr.error('@TempData["error"]');</text>
            }

        });


        /* ================= Grid Framework ================= */

        const standardJqxGridSettings = {
            width: "100%",
            pageable: true,
            sortable: true,
            filterable: true,
            showfilterrow: true,
            columnsresize: true,
            rowsheight: 30,
            columnsheight: 30,
            altrows: true
        };

        const registeredGridSelectors = new Set();

        function registerGrid(selector) {
            if (!selector) return;
            registeredGridSelectors.add(selector);
        }

        function createStandardGrid(selector, options) {
            if (!selector || !$(selector).length) return;

            registerGrid(selector);

            const mergedOptions = $.extend(true, {}, standardJqxGridSettings, options || {});
            $(selector).jqxGrid(mergedOptions);
        }

        function refreshGridLayouts() {
            registeredGridSelectors.forEach(function (selector) {

                const element = $(selector);

                if (!element.length || !element.data("jqxGrid")) return;

                const parent = element.parent().get(0);
                const parentWidth = parent
                    ? Math.floor(parent.getBoundingClientRect().width)
                    : 0;

                if (parentWidth > 0) {
                    element.jqxGrid({ width: parentWidth - 1 });
                }

                element.jqxGrid("refresh");
                element.jqxGrid("render");
                element.jqxGrid("autoresizecolumns", "cells");
            });
        }

        $(window).on("resize", refreshGridLayouts);

        window.LinkwellGrid = {
            defaults: standardJqxGridSettings,
            create: createStandardGrid,
            register: registerGrid,
            refreshLayouts: refreshGridLayouts
        };

    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
