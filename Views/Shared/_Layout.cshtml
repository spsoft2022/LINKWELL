@using System.Security.Claims

@{
    var isLoggedIn = User.Identity.IsAuthenticated;
    var fullName = User.Identity.Name;
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"] - Linkwell</title>
    <meta name="viewport" content="width=device-width" />

    <link href="~/lib/support/bootstrap.min.css" rel="stylesheet">
    <link href="~/lib/support/toastr.min.css" rel="stylesheet">
    <link href="~/lib/support/jqx.base.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <script src="~/lib/support/jquery.min.js"></script>
    <script src="~/lib/support/bootstrap.bundle.min.js"></script>
    <script src="~/lib/support/jqx-all.js"></script>

    <link href="~/lib/support/quill.snow.css" rel="stylesheet">
    <script src="~/lib/support/quill.min.js"></script>

    <script src="~/lib/support/toastr.min.js"></script>

    <style>

        .sidebar {
    width: 250px;
    transition: all 0.3s ease;
}

.sidebar.collapsed {
    width: 70px;
}

.menu-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    margin: 6px 0;
    text-decoration: none;
    border-radius: 6px;
}

.menu-link:hover {
    background: rgba(255,255,255,0.2);
}

.sidebar.collapsed .menu-text {
    display: none;
}
        #toast-container {
            z-index: 999999 !important;
        }

        #userMenuBtn:hover {
            background-color: #0b5ed7;
        }

        .dropdown-menu {
            min-width: 180px;
        }
    </style>
</head>

<body>

    @if (isLoggedIn)
    {
        <!-- LOGGED-IN LAYOUT -->
        <div class="d-flex" style="min-height:100vh;">

            <!-- SIDEBAR -->
            <div id="sidebar" class="bg-primary text-white p-3 sidebar">

                <h4 class="text-center border-bottom pb-2 menu-text">
                    LINKWELL
                </h4>

                <a asp-controller="Category" asp-action="Index"
                   class="menu-link text-white">
                    <i class="bi bi-tags"></i>
                    <span class="menu-text">Category</span>
                </a>

                <a asp-controller="Model" asp-action="Index"
                   class="menu-link text-white">
                    <i class="bi bi-box"></i>
                    <span class="menu-text">Models</span>
                </a>

                <a asp-controller="Station" asp-action="Index"
                   class="menu-link text-white">
                    <i class="bi bi-building"></i>
                    <span class="menu-text">Stations</span>
                </a>

                <a asp-controller="Model" asp-action="AssignStation"
                   class="menu-link text-white">
                    <i class="bi bi-diagram-3"></i>
                    <span class="menu-text">Assign Stations</span>
                </a>

                <a asp-controller="WorkInstruction" asp-action="AddInstructions"
                   class="menu-link text-white">
                    <i class="bi bi-journal-text"></i>
                    <span class="menu-text">Instructions</span>
                </a>

            </div>
            <!-- RIGHT SIDE -->
            <div class="flex-grow-1 d-flex flex-column">

                <!-- HEADER -->
                <div class="bg-light p-3 border-bottom d-flex justify-content-between">
                <button id="toggleSidebar" class="btn btn-outline-primary">
                <i class="bi bi-list"></i>
                </button>

                    <div>
                        <strong>@fullName</strong>
                        <span class="text-muted">
                            (@role)
                        </span>
                    </div>

                    <div class="dropdown">

                        <div id="userMenuBtn"
                             class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                             data-bs-toggle="dropdown"
                             style="width:40px;height:40px;cursor:pointer;">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <ul class="dropdown-menu dropdown-menu-end shadow">

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Account"
                                   asp-action="Profile">
                                    Profile
                                </a>
                            </li>

                            <li><hr class="dropdown-divider"></li>

                            <li>
                                <a class="dropdown-item text-danger"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>

                        </ul>

                    </div>
                </div>

                <!-- CONTENT -->
                <div class="p-4 bg-light flex-grow-1">
                    @RenderBody()
                </div>

                <!-- FOOTER -->
                <div class="bg-light text-center p-2 border-top">
                    © @DateTime.Now.Year Linkwell Electronics
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- LOGIN PAGE ONLY -->
        @RenderBody()
    }

    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000"
        };

        @if (TempData["success"] != null)
        {
                <text>toastr.success('@TempData["success"]');</text>
        }

        @if (TempData["error"] != null)
        {
                <text>toastr.error('@TempData["error"]');</text>
        }

        $("#toggleSidebar").click(function () {
            $("#sidebar").toggleClass("collapsed");
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>