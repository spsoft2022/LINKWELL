@using System.Security.Claims

@{
    var isLoggedIn = User.Identity.IsAuthenticated;
    var fullName = User.Identity.Name;
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"] - Linkwell</title>
    <meta name="viewport" content="width=device-width" />

    <!-- ================= CSS ================= -->
    <link href="~/lib/support/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/lib/support/toastr.min.css" rel="stylesheet" />
    <link href="~/lib/support/jqx.base.css" rel="stylesheet" />
    <link href="~/lib/support/quill.snow.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />

    <!-- ================= JS LIBRARIES ================= -->
    <script src="~/lib/support/jquery.min.js"></script>
    <script src="~/lib/support/bootstrap.bundle.min.js"></script>
    <script src="~/lib/support/jqx-all.js"></script>
    <script src="~/lib/support/quill.min.js"></script>
    <script src="~/lib/support/toastr.min.js"></script>

    <!-- ================= GLOBAL STYLES ================= -->
    <style>
        body {
            overflow-x: hidden;
        }

        .app-shell {
            min-height: 100vh;
        }

        /* ================= SIDEBAR ================= */

        .sidebar {
            width: 219px;
            min-height: 100vh;
            background: #fff;
            border-right: 1px solid #ddd;
            transition: width 0.25s ease;
            overflow: hidden;
        }

        .sidebar.collapsed {
        width: 76px;
        }

        /* Hide section titles */
        .sidebar.collapsed .menu-title {
            display: none;
        }


        /* Hide text */
        .sidebar.collapsed .menu-text {
            display: none;
        }

        /* Center icons */
        .sidebar.collapsed .menu-link {
            width: 60px;
            justify-content: center;
            padding: 10px 0;
            margin: 6px auto;
        }

        .user-menu-container {
            position: relative;
        }

        .user-menu-arrow {
            cursor: pointer;
            padding: 5px;
        }

        /* Dropdown */

        .user-menu-dropdown {
            position: absolute;
            top: 30px;
            right: 0;
            width: 183px;
            background: #ffffff;
            border: 1px solid #D9D9D9;
            border-radius: 5px;
            display: none;
            flex-direction: column;
            padding: 10px;
            gap: 1px;
        }

        /* Menu options */



        .user-menu-option {
            display: flex;
            align-items: center;
            height: 38px;
            padding: 10px;
            font-family: 'Poppins', sans-serif;
            font-weight: 500;
            font-size: 12px;
            color: #222222;
            cursor: pointer;
            border-radius: 4px;
            text-decoration:none;
        }


        .user-menu-option:hover {
            background: #F5F5F5;
        }

            /* Remove hover text slide animation when collapsed */
        .sidebar.collapsed .menu-link:hover .menu-text {
            transform: none;
        }

        /* Adjust logo */
        .sidebar.collapsed .sidebar-logo img {
        max-width: 42px;
        }

        .sidebar-logo {
            text-align: center;
            height: 60px;
            border-bottom: 1px solid #ddd;
            padding: 20px 0;
        }

            .sidebar-logo img {
                width: 179px;
                transition: all 0.25s ease;
            }

      

        .brand-short {
            display: none;
        }

        .sidebar.collapsed .brand-full {
            display: none;
        }

        .sidebar.collapsed .brand-short {
            display: inline;
        }

        .menu-section {
            margin-top: 20px;
        }


        .menu-title {
            font-family: 'Inter', sans-serif;
            font-weight: 400;
            font-size: 14px;
            line-height: 20px;
            letter-spacing: 0;
            padding: 8px 16px;
            width: 198px;
            height: 28px;
        }

        .sidebar.collapsed .menu-title {
            display: none;
        }

        .menu-link {
            width:198px;
            height:28px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            margin: 4px 8px;
            border-radius: 6px;
            color: #444;
            text-decoration: none;
            font-size: 14px;
            transition: 0.2s ease;
        }

            .menu-link:hover {
                background: #e9ecef;
                color: #000;
            }


        .menu-text {
            transition: transform 0.3s ease, color 0.3s ease;
        }

        .menu-link:hover .menu-text {
            transform: translateX(8px);
        }
               
            .menu-link.active {
                border-right: 4px solid #FF8D28;
                font-weight: 600;
                color: #FF8D28;
                background: #EFEFEF;
            }

        .menu-icon {
            font-size: 18px;
            min-width: 22px;
            text-align: center;
        }

        .sidebar.collapsed .menu-link {
            justify-content: center;
        }

        .sidebar.collapsed .menu-text {
            display: none;
        }

        /* ================= TOPBAR ================= */

        .topbar {
            height: 60px;
            background: linear-gradient(to right, #2c2c2c, #1f1f1f);
            color: white;
            border-bottom: 1px solid #333;
        }


        .name-badge {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 12px;
            width: 187px;
            height: 36px;
            padding: 4px 12px;
            border-radius: 12px;
            font-family: 'Inter', sans-serif;
        }

        .user-info {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
        }

        .username {
            font-size: 14px;
            font-weight: 700;
            color: #D9D9D9;
            line-height: 18px;
        }

        .role {
            font-size: 10px;
            color: #FF8D28;
        }

        .avatar {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            overflow: hidden;
            background: rgba(28,28,28,0.05);
        }

            .avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }


        /* Dropdown */

        .dropdown-menu {
            position: absolute;
            top: 50px;
            right: 40px;
            display: none;
            flex-direction: column;
            background: white;
            border: 1px solid #ddd;
            border-radius: 6px;
            width: 120px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

            .dropdown-menu button {
                border: none;
                background: none;
                padding: 10px;
                text-align: left;
                cursor: pointer;
            }

                .dropdown-menu button:hover {
                    background: #e9ecef;
                    color: #000;
                }
        .menu-icon {
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(28,28,28,0.05);
            color: #F6901E;
            font-size: 12px;
            cursor: pointer;
        }

        .content-area {
            min-width: 0;
        }

        #toast-container {
            z-index: 999999 !important;
        }
        .bbgc{
            background-color: #EFEFEF;
        }

        .breadcrumb-wrapper {
            display: flex;
            justify-content: center;
        }

        .custom-breadcrumb {
            width: 100%;
            max-width: 1161px;
        }

        /* ===== Breadcrumb Container ===== */
        .custom-breadcrumb {
            box-sizing: border-box;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 43px;
            padding: 5px 0 10px;
            border-bottom: 1px solid #C9C9C9;
            font-family: "Inter", "Segoe UI", sans-serif;
        }

        /* ===== Left Section ===== */
        .breadcrumb-left {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 14px;
            line-height: 20px;
            font-weight: 500;
        }

        /* ===== Breadcrumb Link ===== */
        .crumb-link {
            width: 41px;
            height: 20px;
            text-decoration: none;
            color: #6B7280; /* soft gray */
            display: inline-block;
            /* Transition should be here */
            transition: color 0.3s ease, transform 0.3s ease;
        }

          

            /* ===== Active Link ===== */
            .crumb-link.active {
                font-weight: 700;
            }



        /* ===== Separator ===== */
        .separator {
            color: #A0A0A0;
            font-weight: 400;
        }

        /* ===== Current Page ===== */
        .crumb-current {
            font-family: Inter, sans-serif;
            font-weight: 400;
            color: #FF8D28;
        }
    




    </style>
</head>

<body>

    @if (isLoggedIn)
    {
        <div class="d-flex app-shell">

            <!-- ================= SIDEBAR ================= -->
            <aside id="sidebar" class="sidebar">

                <div class="sidebar-logo">
                    <img src="~/images/logo-full.png" class="brand-full" />
                    <img src="~/images/logo-icon.png" class="brand-short" />
                </div>

                <!-- DASHBOARDS -->
                <div class="menu-section">
                    <div class="menu-title">Dashboards</div>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="menu-link"
                       data-menu-text="Dashboard">
                        <img src="~/images/menuicons/dashboard.svg" class="menu-icon" alt="Dashboard" />
                        <span class="menu-text">Dashboard</span>
                    </a>
                </div>

                <!-- MENU -->
                <div class="menu-section">  
                    <div class="menu-title">Menu</div>

                    <a asp-controller="Category" asp-action="Index"
                       class="menu-link" data-menu-text="Category">
                        <img src="~/images/menuicons/category.svg" class="menu-icon" alt="Category" />
                        <span class="menu-text">Category</span>
                    </a>

                    <a asp-controller="Model" asp-action="Index"
                       class="menu-link" data-menu-text="Models">
                        <img src="~/images/menuicons/models.svg" class="menu-icon" alt="Models" />
                        <span class="menu-text">Models</span>
                    </a>

                    <a asp-controller="Station" asp-action="Index"
                       class="menu-link" data-menu-text="Stations">
                        <img src="~/images/menuicons/stations.svg" class="menu-icon" alt="Stations" />
                        <span class="menu-text">Stations</span>
                    </a>

                    <a asp-controller="Model" asp-action="AssignStation"
                       class="menu-link" data-menu-text="Assign Stations">
                        <img src="~/images/menuicons/assign.svg" class="menu-icon" alt="AssignStations" />
                        <span class="menu-text">Assign Stations</span>
                    </a>
                </div>

                <!-- MANUALS -->
                <div class="menu-section">
                    <div class="menu-title">Manuals</div>

                    <a asp-controller="WorkInstruction"
                       asp-action="AddInstructions"
                       class="menu-link"
                       data-menu-text="Instructions">
                        <img src="~/images/menuicons/instructions.svg" class="menu-icon" alt="Instructions" />
                        <span class="menu-text">Instructions</span>
                    </a>
                </div>

                <!-- HELP -->
                <div class="menu-section">
                    <div class="menu-title">Help</div>

                    <a asp-controller="Account"
                       asp-action="Profile"
                       class="menu-link"
                       data-menu-text="Profile">
                        <i class="bi bi-person menu-icon"></i>
                        <span class="menu-text">Profile</span>
                    </a>
                </div>

            </aside>
            <!-- ================= RIGHT SIDE ================= -->
            <div class="flex-grow-1 d-flex flex-column content-area">

                <!-- TOPBAR -->
                <div class="topbar d-flex align-items-center justify-content-between px-4">

                    <div class="d-flex align-items-center gap-3">
                      
                        <img id="toggleSidebar"  src="~/images/collposelefticon.png" alt="avatar">
                        <span class="fs-5 fw-semibold">
                            Instructions display system
                        </span>
                    </div>


                    <div class="name-badge">

                        <div class="user-info">
                            <div class="username">@fullName</div>
                            <div class="role">Login as @role</div>
                        </div>

                        <div class="avatar">
                            <img src="~/images/avatar.png" alt="avatar">

                        </div>

                       

                        <div class="menu-container">
                            <div class="menu-icon" onclick="toggleMenu()">
                                <img src="~/images/profilecontexarrow.png" alt="arrow">
                            </div>

                            <div class="dropdown-menu" id="dropdownMenu">
                         
                             

                                <a asp-controller="Account"
                                   asp-action="Profile"
                                   class="user-menu-option"
                                   data-menu-text="Profile">
                                    <span>Profile</span>
                                </a>

                                <a class="user-menu-option"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </div>
                        </div>

                    </div>



                </div>

                <!-- CONTENT -->
                <div class="bbgc flex-grow-1 p-3">

                    <div class="breadcrumb-wrapper">
                    <div class="custom-breadcrumb">
                    <div class="breadcrumb-left">
                    <a href="/" class="crumb-link active">Home</a>
                    <span class="separator">/</span>
                    <span class="crumb-current">@ViewData["Title"]</span>
                    </div>
                    </div>
                    </div>
                    <!-- Breadcrumb -->
              
                    @RenderBody()
                </div>

                <!-- FOOTER -->
                <div class="bbgc text-center p-2 border-top">
                    © @DateTime.Now.Year Linkwell Electronics
                </div>

            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <!-- ================= SCRIPTS ================= -->
    <script>
        $(function () {

            /* Sidebar Toggle */
            const sidebar = $("#sidebar");

            function applySidebarState(collapsed) {
                sidebar.toggleClass("collapsed", collapsed);

                $(".menu-link").each(function () {
                    const text = $(this).data("menu-text");
                    $(this).attr("title", collapsed ? text : "");
                });

                refreshGridLayouts();
            }

            const savedState = localStorage.getItem("sidebarState") === "collapsed";
            applySidebarState(savedState);

            $("#toggleSidebar").click(function () {
                const collapsed = !sidebar.hasClass("collapsed");
                applySidebarState(collapsed);
                localStorage.setItem("sidebarState",
                    collapsed ? "collapsed" : "expanded");
            });

            /* Active Menu */
                /* ================= Active Menu (Final Fix) ================= */

        const pathParts = window.location.pathname
            .toLowerCase()
            .split('/')
            .filter(Boolean);

        const currentController = pathParts[0] || "";
        const currentAction = pathParts[1] || "index";

        let bestMatch = null;
        let bestMatchLength = 0;

        $(".menu-link").each(function () {

            const href = $(this).attr("href");
            if (!href) return;

            const linkParts = href.toLowerCase()
                .split('/')
                .filter(Boolean);

            const linkController = linkParts[0] || "";
            const linkAction = linkParts[1] || "index";

            // Match controller first
            if (linkController === currentController) {

                // Exact controller + action match gets priority
                if (linkAction === currentAction) {
                    bestMatch = $(this);
                    bestMatchLength = 2;
                }

                // Controller-only match (fallback)
                else if (bestMatchLength < 1) {
                    bestMatch = $(this);
                    bestMatchLength = 1;
                }
            }
        });

        if (bestMatch) {
            $(".menu-link").removeClass("active");
            bestMatch.addClass("active");
        }

            /* Toastr */
            toastr.options = {
                closeButton: true,
                progressBar: true,
                positionClass: "toast-top-right",
                timeOut: 3000
            };

            @if (TempData["success"] != null)
            {
                    <text>toastr.success('@TempData["success"]');</text>
            }

            @if (TempData["error"] != null)
            {
                    <text>toastr.error('@TempData["error"]');</text>
            }

        });

        /* ================= GRID FRAMEWORK ================= */

        const standardJqxGridSettings = {
            width: "100%",
            pageable: true,
            sortable: true,
            filterable: true,
            showfilterrow: true,
            columnsresize: true,
            altrows: true
        };

        const registeredGridSelectors = new Set();

        function registerGrid(selector) {
            registeredGridSelectors.add(selector);
        }

        function createStandardGrid(selector, options) {
            if (!$(selector).length) return;

            registerGrid(selector);
            const merged = $.extend(true, {}, standardJqxGridSettings, options);
            $(selector).jqxGrid(merged);
        }

        function refreshGridLayouts() {
            registeredGridSelectors.forEach(selector => {
                const el = $(selector);
                if (!el.length || !el.data("jqxGrid")) return;

                el.jqxGrid("refresh");
                el.jqxGrid("render");
            });
        }

        $(window).on("resize", refreshGridLayouts);

        window.LinkwellGrid = {
            create: createStandardGrid,
            register: registerGrid,
            refresh: refreshGridLayouts
        };

        function toggleMenu() {
        const menu = document.getElementById("dropdownMenu");

        if (menu.style.display === "flex") {
        menu.style.display = "none";
        } else {
        menu.style.display = "flex";
        }
        }

        function goProfile() {
        alert("Go to Profile Page");
        }

        function logout() {
        alert("Logging out...");
        }

    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>