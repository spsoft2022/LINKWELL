@using System.Security.Claims

@{
    var isLoggedIn = User.Identity.IsAuthenticated;
    var fullName = User.Identity.Name;
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"] - Linkwell</title>
    <meta name="viewport" content="width=device-width" />

    <link href="~/lib/support/bootstrap.min.css" rel="stylesheet">
    <link href="~/lib/support/toastr.min.css" rel="stylesheet">
    <link href="~/lib/support/jqx.base.css" rel="stylesheet" />
    
    <script src="~/lib/support/jquery.min.js"></script>
    <script src="~/lib/support/bootstrap.bundle.min.js"></script>
    <script src="~/lib/support/jqx-all.js"></script>

    <link href="~/lib/support/quill.snow.css" rel="stylesheet">
    <script src="~/lib/support/quill.min.js"></script>

    <script src="~/lib/support/toastr.min.js"></script>

    <style>
        .app-shell {
            min-height: 100vh;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            transition: width 0.25s ease;
            overflow: hidden;
        }

        .sidebar.collapsed {
            width: 76px;
        }

        .brand-short {
            display: none;
        }

        .sidebar.collapsed .brand-full {
            display: none;
        }

        .sidebar.collapsed .brand-short {
            display: inline;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            margin: 6px 0;
            text-decoration: none;
            border-radius: 6px;
            white-space: nowrap;
        }

        .menu-link:hover,
        .menu-link:focus-visible {
            background: rgba(255,255,255,0.2);
        }

        .menu-icon {
            min-width: 18px;
            text-align: center;
            display: inline-block;
        }

        .sidebar.collapsed .menu-link {
            justify-content: center;
            padding-inline: 0;
        }

        .sidebar.collapsed .menu-text {
            display: none;
        }

        .topbar {
            min-height: 76px;
        }

        .content-area {
            min-width: 0;
        }

        #toast-container {
            z-index: 999999 !important;
        }

        #userMenuBtn:hover {
            background-color: #0b5ed7;
        }

        .dropdown-menu {
            min-width: 180px;
        }
    </style>
</head>

<body>

    @if (isLoggedIn)
    {
        <!-- LOGGED-IN LAYOUT -->
        <div class="d-flex app-shell">

            <!-- SIDEBAR -->
            <aside id="sidebar" class="bg-primary text-white p-3 sidebar" aria-label="Main navigation">

                <h4 class="text-center border-bottom pb-2">
                    <span class="brand-full">LINKWELL</span>
                    <span class="brand-short">LW</span>
                </h4>


                <a asp-controller="Dashboard" asp-action="Index"
                   class="menu-link text-white"
                   data-menu-text="Dashboard">
                    <span class="menu-icon" aria-hidden="true">▦</span>
                    <span class="menu-text">Dashboard</span>
                </a>

                <a asp-controller="Category" asp-action="Index"
                   class="menu-link text-white"
                   data-menu-text="Category">
                    <span class="menu-icon" aria-hidden="true">🏷</span>
                    <span class="menu-text">Category</span>
                </a>

                <a asp-controller="Model" asp-action="Index"
                   class="menu-link text-white"
                   data-menu-text="Models">
                    <span class="menu-icon" aria-hidden="true">⬛</span>
                    <span class="menu-text">Models</span>
                </a>

                <a asp-controller="Station" asp-action="Index"
                   class="menu-link text-white"
                   data-menu-text="Stations">
                    <span class="menu-icon" aria-hidden="true">🏭</span>
                    <span class="menu-text">Stations</span>
                </a>

                <a asp-controller="Model" asp-action="AssignStation"
                   class="menu-link text-white"
                   data-menu-text="Assign Stations">
                    <span class="menu-icon" aria-hidden="true">🗂</span>
                    <span class="menu-text">Assign Stations</span>
                </a>

                <a asp-controller="WorkInstruction" asp-action="AddInstructions"
                   class="menu-link text-white"
                   data-menu-text="Instructions">
                    <span class="menu-icon" aria-hidden="true">📘</span>
                    <span class="menu-text">Instructions</span>
                </a>

            </aside>
            <!-- RIGHT SIDE -->
            <div class="flex-grow-1 d-flex flex-column content-area">

                <!-- HEADER -->
                <div class="bg-light p-3 border-bottom d-flex justify-content-between align-items-center topbar">
                    <button id="toggleSidebar"
                            class="btn btn-outline-primary"
                            type="button"
                            aria-controls="sidebar"
                            aria-expanded="true"
                            aria-label="Toggle sidebar">
                        <span id="toggleSidebarIcon" aria-hidden="true">☰</span>
                    </button>

                    <div>
                        <strong>@fullName</strong>
                        <span class="text-muted">
                            (@role)
                        </span>
                    </div>

                    <div class="dropdown">

                        <div id="userMenuBtn"
                             class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                             data-bs-toggle="dropdown"
                             style="width:40px;height:40px;cursor:pointer;">
                            <span aria-hidden="true">👤</span>
                        </div>

                        <ul class="dropdown-menu dropdown-menu-end shadow">

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Account"
                                   asp-action="Profile">
                                    Profile
                                </a>
                            </li>

                            <li><hr class="dropdown-divider"></li>

                            <li>
                                <a class="dropdown-item text-danger"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>

                        </ul>

                    </div>
                </div>

                <!-- CONTENT -->
                <div class="p-4 bg-light flex-grow-1">
                    @RenderBody()
                </div>

                <!-- FOOTER -->
                <div class="bg-light text-center p-2 border-top">
                    © @DateTime.Now.Year Linkwell Electronics
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- LOGIN PAGE ONLY -->
        @RenderBody()
    }

    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000"
        };

        @if (TempData["success"] != null)
        {
                <text>toastr.success('@TempData["success"]');</text>
        }

        @if (TempData["error"] != null)
        {
                <text>toastr.error('@TempData["error"]');</text>
        }

     

        const sidebar = $("#sidebar");
        const toggleBtn = $("#toggleSidebar");
        const toggleIcon = $("#toggleSidebarIcon");
        const menuLinks = sidebar.find(".menu-link");

        function applySidebarState(isCollapsed) {
            sidebar.toggleClass("collapsed", isCollapsed);
            toggleBtn.attr("aria-expanded", String(!isCollapsed));
            toggleIcon.text(isCollapsed ? "☰" : "✕");

            menuLinks.each(function () {
                const menuText = $(this).data("menu-text");
                $(this).attr("title", isCollapsed ? menuText : "");
            });
        }

        // ✅ Restore sidebar state on page load
        const isCollapsedOnLoad = localStorage.getItem("sidebarState") === "collapsed";
        applySidebarState(isCollapsedOnLoad);

        // ✅ Toggle sidebar
        toggleBtn.on("click", function () {
            const newState = !sidebar.hasClass("collapsed");
            applySidebarState(newState);
            localStorage.setItem("sidebarState", newState ? "collapsed" : "expanded");
        });


    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
