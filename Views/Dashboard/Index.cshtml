@{
    ViewData["Title"] = "Dashboard";

    var tiles = new[]
    {
    new { Title = "Category", Description = "To add, edit or modify Category you can directly access from here...", Image = "category.png", Controller = "Category", Action = "Index" },
    new { Title = "Models", Description = "To add, edit or modify models, you can directly access from here...", Image = "models.png", Controller = "Model", Action = "Index" },
    new { Title = "Stations", Description = "To add, edit or modify Stations, you can directly access from here...", Image = "stations.png", Controller = "Station", Action = "Index" },
    new { Title = "Assign Stations", Description = "To configuration station with models, you can directly access from here...", Image = "assign.png", Controller = "Model", Action = "AssignStation" },
    new { Title = "Instructions", Description = "To add, edit or modify Instructions, you can directly access from here...", Image = "instructions.png", Controller = "WorkInstruction", Action = "AddInstructions" },
    new { Title = "User Manual", Description = "To upload user manual, you can directly access from here...", Image = "manual.png", Controller = "Manual", Action = "Index" },
    new { Title = "Profile", Description = "To manage your profile and password settings.", Image = "profile.png", Controller = "Account", Action = "Profile" }
    };

}

<div id="dashboarddiv" class="dashboard-wrapper" style="margin-top:26px">

    @{
        int itemsPerRow = 4;

        for (int i = 0; i < tiles.Length; i += itemsPerRow)
        {
            <div class="dashboard-row">
                @{
                    int itemsRendered = 0;
                }

                @for (int j = i; j < i + itemsPerRow && j < tiles.Length; j++)
                {
                    var tile = tiles[j];
                    itemsRendered++;

                    <a asp-controller="@tile.Controller"
                       asp-action="@tile.Action"
                       class="dashboard-card-link">

                        <div class="dashboard-card">

                            <!-- Header -->
                            <div class="card-header">
                                <div class="card-title">@tile.Title</div>
                            </div>

                            <!-- Icon -->
                            <div class="card-icon">
                                <img src="~/images/tiles/@tile.Image" alt="@tile.Title" />
                            </div>

                            <!-- Description -->
                            <div class="card-description">
                                @tile.Description
                            </div>

                        </div>

                    </a>
                }

                <!-- Fill Empty Slots -->
                @for (int k = itemsRendered; k < itemsPerRow; k++)
                {
                    <div class="dashboard-card empty-card"></div>
                }
            </div>
        }
    }

</div>

<style>
        /* =========================
           DASHBOARD WRAPPER
        ========================= */

    .dashboard-wrapper {
        display: flex;
        flex-direction: column;
        gap: 25px; /* space between rows */
    }

    .dashboard-row {
        display: flex;
        gap: 25px; /* space between cards in same row */
    }

        /* =========================
           DASHBOARD CARD
        ========================= */


    .dashboard-card-link {
        text-decoration: none;
        display: block;
    }

    .dashboard-card {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 20px 15px;
        width: 270px;
        min-width: 171px;
        height: 205px;
        background: #FFFFFF;
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .dashboard-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }


    .empty-card{
        background-color:inherit;
        pointer-events: none;
    }
    /* =========================
           CARD HEADER
        ========================= */

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-title {
            font-family: 'Inter', sans-serif;
            font-weight: 700;
            font-size: 20px;
            color: #7F7F7F;
            letter-spacing: -0.04em;
        }

        /* =========================
           ADD BUTTON
        ========================= */

        .add-btn {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: #F2F2F2;
            border: 1px solid #E9E9E9;
            border-radius: 15px;
            font-family: 'Nexa Bold', sans-serif;
            font-size: 12px;
            font-weight: 700;
            color: #F6901E;
            cursor: pointer;
            transition: 0.3s ease;
        }

            .add-btn:hover {
                background: #F6901E;
                color: #ffffff;
            }

        /* =========================
           ICON AREA
        ========================= */

        .card-icon {
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 20px 0;
        }

            .card-icon img,
            .card-icon svg {
                width: 85px;
                height: 85px;
            }

        /* =========================
           DESCRIPTION
        ========================= */

        .card-description {
            font-family: 'Inter', sans-serif;
            font-size: 10px;
            line-height: 14px;
            text-align: center;
            color: #555555;
        }

 

        


</style>


