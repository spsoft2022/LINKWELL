@{
    ViewData["Title"] = "Assign Stations to Model";
}

<div class="row">
    <div class="col-md-4">
        <label>Model</label>
        <div id="ddlModel"></div>
    </div>
</div>

<br />

<div class="row">
    <div class="col-md-6">
        <label>Stations</label>
        <div id="stationList"></div>
    </div>
</div>

<br />

<button id="btnAssign" class="btn btn-primary">
    Assign Stations
</button>

<script>
    $(document).ready(function () {

        // ===============================
        // LOAD MODELS DROPDOWN
        // ===============================
        $.get('/api/model/get-models', function (data) {

            $("#ddlModel").jqxDropDownList({
                source: data,
                displayMember: "modelName",
                valueMember: "id",
                width: 250,
                height: 30,
                placeHolder: "Select Model"
            });
        });

        // ===============================
        // LOAD STATIONS CHECKBOX LIST
        // ===============================


            $("#stationList").jqxListBox({
            displayMember: "stationCode",
            valueMember: "stationCode",
            checkboxes: true,
            width: '100%',
            height: 300,
            enableSelection: true,
            enableHover: true
            });


    
            $.get('/api/station/get-stations', function(res) {
            $("#stationList").jqxListBox('source', res.data);
            });

            $("#stationList").on('select', function (event) {
            $("#stationList").jqxListBox('checkIndex', event.args.index);
            });



    





        // ===============================
        // ASSIGN BUTTON CLICK
        // ===============================
        $("#btnAssign").on("click", function () {

            const modelId = $("#ddlModel").jqxDropDownList('val');
            const checkedStations = $("#stationList").jqxListBox('getCheckedItems');

            if (!modelId) {
                alert("Please select a model");
                return;
            }

            if (checkedStations.length === 0) {
                alert("Please select at least one station");
                return;
            }

            const stationIds = checkedStations.map(x => x.value);

            const payload = {
                ModelId: modelId,
                StationIds: stationIds
            };

            $.ajax({
                url: '/api/model/assignstations',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function () {
                    alert("Stations assigned successfully");
                }
            });
        });

    });
</script>
