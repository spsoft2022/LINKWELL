@{
    ViewData["Title"] = "Assign Stations to Model";
}

<link rel="stylesheet" href="~/css/common.css" />

<div class="org-container">

    <div class="org-header">
        <div class="left">
            <div>
                <img src="/images/menuicons/assign.svg" class="icon" />
            </div>
            <span class="icontext">Assign Stations</span>
        </div>

    </div>

</div>


<div class="row">
    <div class="col-md-12 d-flex align-items-center gap-5">
        <label class="mb-0">Model</label>

        <div id="ddlModel"></div>

        <button class="add-btn" id="btnAssign">
            Assign Stations
        </button>
    </div>
</div>

<br />

<div class="row">
    <div class="col-md-6">
        <label>Stations</label>
        <div id="stationList"></div>
    </div>
</div>




<script>
    $(document).ready(function () {

        // ===============================
        // LOAD MODELS DROPDOWN
        // ===============================
        $.get('/api/model/get-models', function (data) {
            $("#ddlModel").jqxDropDownList({
                source: data,
                displayMember: "modelName",
                valueMember: "id",
                width: 250,
                height: 30,
                placeHolder: "Select Model"
            });
        });


        // ===============================
        // LOAD STATIONS CHECKBOX LIST
        // ===============================
        $.get('/api/station/get-stations', function (res) {

            res.data.forEach(function (item) {
            item.displayText = item.stationCode + " - " + item.stationName;
            });

           $("#stationList").jqxListBox({
        source: res.data,
        displayMember: "displayText",
        valueMember: "id",
        checkboxes: true,
        filterable: true,
        searchMode: 'containsignorecase',
        width: '100%',
        height: 300
    });
            // when stations binding is complete, load any assigned mapping
            $("#stationList").on('bindingComplete', loadMappedStations);
        });


        // ===============================
        // HELPERS
        // ===============================
        function uncheckAllStations() {
            const items = $("#stationList").jqxListBox('getItems');
            if (!items) return;
            items.forEach((_, i) => $("#stationList").jqxListBox('uncheckIndex', i));
        }

        function loadMappedStations() {
            const modelId = $("#ddlModel").jqxDropDownList('val');
            if (!modelId) return;

            $.get('/api/model/get-mapped-stations/' + modelId, function (mappedIds) {

                if (!mappedIds || mappedIds.length === 0) return;

                const items = $("#stationList").jqxListBox('getItems');
                if (!items) return;

                items.forEach((item, index) => {
                    if (mappedIds.includes(item.value)) {
                        $("#stationList").jqxListBox('checkIndex', index);
                    }
                });
            });
        }


        // ===============================
        // MODEL CHANGE EVENT
        // ===============================
        $("#ddlModel").on('change', function () {
            uncheckAllStations();
            loadMappedStations();
        });


        // ===============================
        // ASSIGN BUTTON CLICK
        // ===============================
           $("#btnAssign").on("click", function () {

        let modelId = $("#ddlModel").jqxDropDownList('val');
        const checkedStations = $("#stationList").jqxListBox('getCheckedItems');

        if (!modelId) {
             toastr.error("Please select a model");
            return;
        }

        if (checkedStations.length === 0) {
            toastr.error("Please select at least one station");
            return;
        }

        const stationIds = checkedStations.map(x => parseInt(x.value));


        const payload = {
            ModelId: parseInt(modelId),   // <-- IMPORTANT
            ids: stationIds
        };

        $.ajax({
            url: '/api/model/assignstations',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function () {
                toastr.success("Stations assigned successfully");
            }
        });
    });

    });
</script>

