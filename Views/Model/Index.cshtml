@{
	ViewData["Title"] = "Model Management";
}

<button class="btn btn-primary mb-3" id="btnAddModel">
	➕ Add Model
</button>

<style>
	#modelGrid {
		border: 1px solid #dee2e6;
		border-radius: 8px;
		overflow: hidden;
		background-color: #fff;
	}

	#modelGrid .jqx-grid-header {
		background: #f8f9fa;
		border-bottom: 1px solid #dee2e6;
		font-weight: 600;
	}

	#modelGrid .jqx-grid-cell {
		font-size: 0.95rem;
	}


	/* Grid wrapper scroll */
	.grid-wrapper {
		height: 500px;
		overflow-y: auto;
	}

		/* Sticky Header */
		.grid-wrapper .jqx-grid-header {
			position: sticky !important;
			top: 0;
			z-index: 20;
			background: #fff;
			box-shadow: 0 2px 6px rgba(0,0,0,0.08);
		}

		/* Sticky Filter Row */
		.grid-wrapper .jqx-grid-filter-row {
			position: sticky !important;
			top: 45px;
			z-index: 19;
			background: #fff;
		}

	/* Status badge */
	.status-pill {
		padding: 4px 10px;
		border-radius: 20px;
		font-size: 12px;
		font-weight: 600;
		display: inline-block;
	}

		.status-pill.active {
			background: #e6f7ee;
			color: #1e7e34;
		}

		.status-pill.disabled {
			background: #fdeaea;
			color: #c82333;
		}

	/* Row hover UX */
	.jqx-grid-cell:hover {
		background-color: #f5f7fa !important;
	}

	.status-pill {
		display: inline-block;
		padding: 3px 10px;
		border-radius: 999px;
		font-size: 0.8rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.status-pill.active {
		color: #0a7d2c;
		background-color: #e8f7ed;
	}

	.status-pill.disabled {
		color: #a21f2d;
		background-color: #fbe9eb;
	}
</style>

<div class="grid-wrapper">
	<div id="modelGrid"></div>
</div>

<div class="modal fade" id="modelModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">

			<div class="modal-header">
				<h5 class="modal-title">Add Model</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>

			<div class="modal-body">
				<input type="hidden" id="modelId">
				<p class="small text-muted mb-3">Fields marked with <span class="text-danger" aria-hidden="true">*</span> are required.</p>

				<div class="mb-2">
					<label for="modelCode">Model Code <span class="text-danger" aria-hidden="true">*</span></label>
					<input type="text" class="form-control" id="modelCode" required aria-required="true">
				</div>

				<div class="mb-2">
					<label for="modelName">Model Name <span class="text-danger" aria-hidden="true">*</span></label>
					<input type="text" class="form-control" id="modelName" required aria-required="true">
				</div>

				<div class="mb-2">
					<label for="description">Description</label>
					<textarea class="form-control" id="description"></textarea>
				</div>
				<div class="mb-2">
					<label for="categoryId">Category <span class="text-danger" aria-hidden="true">*</span></label>
					<select class="form-select" id="categoryId" required aria-required="true"></select>
				</div>

			</div>

			<div class="modal-footer">
				<button class="btn btn-secondary" id="btnCancelModel" data-bs-dismiss="modal">Cancel</button>
				<button class="btn btn-success" id="btnSaveModel">Save</button>
			</div>

		</div>
	</div>
</div>

<script>
	$(document).ready(function () {
		loadModelGrid();

	});
	 let modelModal;


	 function loadCategories(callback) {
    $.get("/category/get-categories", function (res) {
        $("#categoryId").empty();
        $("#categoryId").append(`<option value="">-- Select --</option>`);

        res.data.forEach(c => {
            $("#categoryId").append(
                `<option value="${c.categoryId}">${c.categoryName}</option>`
            );
        });

        if (callback) callback();
    });
}


	/* ---------------- ADD MODEL ---------------- */
	$("#btnAddModel").click(function () {
		clearModelForm();
		$(".modal-title").text("Add Model");
			$("#modelCode").prop("disabled", false).prop("readonly", false);
		// 🔹 load categories before showing modal
		loadCategories(function () {
			modelModal = new bootstrap.Modal(
				document.getElementById('modelModal')
			);
			modelModal.show();
		});
	});


	/* ---------------- EDIT MODEL ---------------- */
	function editModel(rowIndex) {

		const rowData = $("#modelGrid").jqxGrid('getrowdata', rowIndex);

		$("#modelId").val(rowData.id);
		$("#modelCode").val(rowData.modelCode);
		$("#modelName").val(rowData.modelName);
		$("#description").val(rowData.description);
			  loadCategories(function () {
				console.log(rowData);

					var categoryText = rowData.categoryName.toLowerCase();

	$("#categoryId option").filter(function () {
		return $(this).text().trim().toLowerCase() === categoryText;
	}).prop("selected", true).trigger("change");



		});
	    // $("#categoryId").val(rowData.categoryId);

		$(".modal-title").text("Edit Model");

		var modal = new bootstrap.Modal(document.getElementById('modelModal'));
		modal.show();
	}

	/* ---------------- CLEAR FORM ---------------- */
	function clearModelForm() {
		$("#modelId").val("");
		$("#modelCode").val("");
		$("#modelName").val("");
		$("#description").val("");
	}

	/* ---------------- SAVE MODEL ---------------- */
		$("#btnSaveModel").on("click", function () {

		const id = $("#modelId").val();

		const data = {
			Id: id ? parseInt(id) : null,
		    CategoryId: $("#categoryId").val() ? parseInt($("#categoryId").val()) : null,
			ModelCode: $("#modelCode").val().trim(),
			ModelName: $("#modelName").val().trim(),
			Description: $("#description").val(),
			IsActive: true
		};

		if (!data.ModelCode || !data.ModelName || !data.CategoryId) {
			toastr.error("Model Code, Model Name, and Category are required");
			return;
		}

		$.ajax({
			url: "/api/model/save",
			type: "POST",
			contentType: "application/json",
			data: JSON.stringify(data),
			success: function (res) {

				toastr.success(res.message);

				$("#modelGrid").jqxGrid('updatebounddata');

				// Close Bootstrap modal
				const modalEl = document.getElementById('modelModal');
				const modal = bootstrap.Modal.getInstance(modalEl);
				if (modal) modal.hide();
			},
				  error: function (xhr) {
			let msg = "Save failed";

			if (xhr.responseJSON) {
				const res = xhr.responseJSON;

				// ASP.NET validation format
				if (res.errors) {
					// Flatten first error
					const allErrors = [];
					for (let key in res.errors) {
						allErrors.push(...res.errors[key]);
					}
					msg = allErrors.join("<br/>");
				}
				else if (res.message) {
					msg = res.message;
				}
			}

			toastr.error(msg);
		}
		});
	});


	/* ---------------- ENABLE / DISABLE ---------------- */
	function toggleModel(modelId, isActive) {

		const action = isActive ? "disable" : "enable";

		if (!confirm(`Are you sure you want to ${action} this model?`))
			return;

		$.ajax({
			url: "/api/model/toggle",
			type: "PUT",
			contentType: "application/json",
			data: JSON.stringify({
				id: modelId,
				isActive: !isActive
			}),
			success: function (res) {
				if (res.success) {
					toastr.success(res.message);
					$("#modelGrid").jqxGrid('updatebounddata');
				} else {
					toastr.error(res.message);
				}
			},
			error: function () {
				toastr.error("Model update failed");
			}
		});
	}

	/* ---------------- GRID ---------------- */
	function loadModelGrid() {


			var source = {
			datatype: "json",
			url: "/api/model/get-models",
			root: "data",
			datafields: [
			{ name: "id", type: "number" },
			{ name: "modelCode", type: "string" },
			{ name: "modelName", type: "string" },
			{ name: "description", type: "string" },
			{ name: "isActive", type: "bool" },
			{ name: "categoryId", type: "number" },
			{ name: "categoryName", type: "string" }
			]
			};

		var adapter = new $.jqx.dataAdapter(source);

		$(document).ready(function () {

		window.LinkwellGrid.create("#modelGrid", {
			height: 500, // ✅ Required for sticky header

			source: adapter,

			theme: "light",

			pagesize: 10,
			pagesizeoptions: ['10', '20', '50', '100'],


			columnsreorder: true,

			enablehover: true,
			enabletooltips: true,

			selectionmode: "singlerow",
			columnsheight: 45,

			showstatusbar: true,
			statusbarheight: 30,

			localization: {
				emptydatastring: "No models found"
			},

			columns: [
				{
					text: "Category",
					datafield: "categoryName",
					width: "20%",
					align: "center"
				},
				{
					text: "Model Code",
					datafield: "modelCode",
					width: "12%",
					align: "center",
					cellsalign: "center"
				},
				{
					text: "Model Name",
					datafield: "modelName",
					width: "25%"
				},
				{
					text: "Description",
					datafield: "description",
					width: "23%"
				},
				{
					text: "Status",
					datafield: "isActive",
					width: "8%",
					align: "center",
					cellsalign: "center",
					cellsrenderer: function (row, col, val) {
						return val
							? "<div class='status-pill active'>Active</div>"
							: "<div class='status-pill disabled'>Disabled</div>";
					}
				},
				{
					text: "Actions",
					width: "12%",
					align: "center",
					cellsalign: "center",
					sortable: false,
					filterable: false,
					cellsrenderer: function (row) {

						const data =
							$("#modelGrid").jqxGrid('getrowdata', row);

						const toggleText =
							data.isActive ? "Disable" : "Enable";

						const toggleClass =
							data.isActive ? "btn-danger" : "btn-success";

						return `
							<div class="d-flex justify-content-center gap-1">
								<button class="btn btn-sm btn-outline-primary"
									onclick="editModel(${row})">
									Edit
								</button>

								<button class="btn btn-sm ${toggleClass}"
									onclick="toggleModel(${data.id}, ${data.isActive})">
									${toggleText}
								</button>
							</div>
						`;
					}
				}
			]
		});

	});


	}

</script>
