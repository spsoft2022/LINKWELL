@using LinkwellProductionSystem.ViewModels
@model LoginViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Login";
}

@section Scripts {
    <script>
        $(document).ready(function () {

            var errors = [];

            @foreach (var value in ViewData.ModelState.Values)
            {
                    foreach (var error in value.Errors)
                    {
                            <text>
                                errors.push("@error.ErrorMessage");
                            </text>
                    }
            }

            errors.forEach(function (msg) {
                toastr.error(msg);
            });

        });
    </script>
}

<div class="container vh-100 d-flex align-items-center justify-content-center">

    <div class="col-md-7">
    </div>
    <div class="col-md-5">
        <div class="card shadow" style="width:350px;">
            <div class="card-body">
                <h4 class="text-center mb-3">Admin Login</h4>

                <form asp-action="Login" method="post">

                    <input asp-for="Username" class="form-control mb-3" placeholder="Username" />

                    <input asp-for="Password" type="password" class="form-control mb-3" placeholder="Password" />

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Remember Me</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Login</button>

                    <div class="text-center mt-3">
                        <a asp-controller="Account" asp-action="ForgotPassword">Forgot Password?</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>