@using LinkwellProductionSystem.ViewModels
@model LoginViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Login";
}

@section Scripts {
    <script>
        $(document).ready(function () {
            const rememberMeKey = "rememberedUsername";
            const rememberedUsername = localStorage.getItem(rememberMeKey);

            if (rememberedUsername) {
                $("#Username").val(rememberedUsername);
                $("#RememberMe").prop("checked", true);
            }




            $("form").on("submit", function () {
                if ($("#RememberMe").is(":checked")) {
                    localStorage.setItem(rememberMeKey, $("#Username").val());
                } else {
                    localStorage.removeItem(rememberMeKey);
                }
            });

            var errors = [];

            @foreach (var value in ViewData.ModelState.Values)
            {
                    foreach (var error in value.Errors)
                    {
                            <text>
                                errors.push("@error.ErrorMessage");
                            </text>
                    }
            }

            errors.forEach(function (msg) {
                toastr.error(msg);
            });

        });
        function togglePassword() {
        var input = document.getElementById("Password");
        input.type = input.type === "password" ? "text" : "password";
        }
            
            </script>
}

<div class="login-wrapper">

    <!-- LEFT BRANDING -->
    <div class="left-section">
        <div class="branding">
            <img src="~/images/logo.png" class="logo" />
            <h2>Linkwell Telesystems</h2>
            <p>
                An Instruction Display System in a MES provides real-time,
                step-by-step work instructions to operators on the shop floor.
            </p>
        </div>
    </div>

    <!-- RIGHT LOGIN -->
    <div class="right-section">
        <div class="login-card">

            <!-- Header -->
            <div class="login-header">
                <p class="welcome-text">Welcome to</p>

                <h4 class="login-title">
                    Instructions display system
                </h4>

                <p class="login-subtext">
                    Please enter login with your username and password
                </p>
            </div>

            <!-- Form -->
            <form asp-action="Login" method="post" class="login-form">

                <!-- Employee ID -->
                <div class="form-group">
                    <label class="form-label">
                        Employee ID <span class="required">*</span>
                    </label>

                    <input asp-for="Username"
                           class="form-control-custom"
                           placeholder="Please Enter Your User Name"
                           autocomplete="username" />
                </div>

                <!-- Password -->
                <div class="form-group">
                    <label class="form-label">
                        Password <span class="required">*</span>
                    </label>
                    <div class="password-wrapper">
                    <input asp-for="Password"
                           type="password"
                           class="form-control-custom"
                           placeholder="Please Enter Password"
                           autocomplete="current-password" />

                    <span class="eye-icon" onclick="togglePassword()">
                        👁
                    </span>
                    </div>
                </div>

                <!-- Options -->
                <div class="login-options">
                    <label class="remember-label">
                        <input asp-for="RememberMe" />
                        <span>Remember Me</span>
                    </label>

                    <a asp-controller="Account"
                       asp-action="ForgotPassword"
                       class="forgot-link">
                        Forgot Password
                    </a>
                </div>

                <!-- Button -->
                <button type="submit" class="login-btn">
                    LOGIN
                </button>

            </form>

        </div>

    </div>

</div>

<footer class="login-footer">
    ©2025 VISIONTEK, Linkwell Telesystems Pvt. Ltd. | All Rights Reserved.
</footer>
