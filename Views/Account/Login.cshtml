@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Login";
}

<div class="container vh-100 d-flex align-items-center justify-content-center">
    <div class="col-md-7">
      
        </div>
    

<div class="col-md-5">
    <div class="card shadow" style="width:350px;">
        <div class="card-body">
            <h4 class="text-center mb-3">Admin Login</h4>

            <form method="post">
                <input name="Username" class="form-control mb-3" placeholder="Username" />
                <input name="Password" type="password" class="form-control mb-3" placeholder="Password" />
                <button class="btn btn-primary w-100">Login</button>
                    <div class="text-center mt-3">
                        <a asp-controller="Account" asp-action="ForgotPassword">Forgot Password?</a>
                    </div>
            </form>

           
        </div>
    </div>
</div>
</div>
