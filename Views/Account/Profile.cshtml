@using LinkwellProductionSystem.ViewModels
@model ProfilePageVM

@{
    ViewData["Title"] = "Profile";
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            var errors = [];

            @foreach (var value in ViewData.ModelState.Values)
            {
                foreach (var error in value.Errors)
                {
                    <text>errors.push("@error.ErrorMessage");</text>
                }
            }

            errors.forEach(function (msg) {
                toastr.error(msg);
            });
        });
    </script>
}

<div class="container mt-4">
    <div class="row justify-content-center g-4">
        <div class="col-lg-7">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-person-circle"></i> Profile
                    </h5>
                </div>

                <div class="card-body">
                    <p class="small text-muted mb-3">Fields marked with <span class="text-danger">*</span> are required.</p>

                    <form asp-action="UpdateProfile" method="post" novalidate aria-describedby="profile-form-hint">
                        <div id="profile-form-hint" class="visually-hidden">Complete all required fields before updating your profile.</div>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" aria-live="assertive"></div>

                        <div class="mb-3">
                            <label asp-for="Profile.UserName" class="form-label"></label>
                            <span class="text-danger" aria-hidden="true">*</span>
                            <input asp-for="Profile.UserName"
                                   class="form-control"
                                   autocomplete="username"
                                   maxlength="50"
                                   required
                                   aria-required="true" />
                            <span asp-validation-for="Profile.UserName" class="invalid-feedback d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Profile.Email" class="form-label"></label>
                            <span class="text-danger" aria-hidden="true">*</span>
                            <input asp-for="Profile.Email"
                                   type="email"
                                   class="form-control"
                                   autocomplete="email"
                                   inputmode="email"
                                   required
                                   aria-required="true" />
                            <span asp-validation-for="Profile.Email" class="invalid-feedback d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Profile.Role" class="form-label"></label>
                            <input asp-for="Profile.Role"
                                   class="form-control"
                                   readonly
                                   aria-readonly="true"
                                   style="background-color:#e9ecef;opacity:1;cursor:not-allowed;" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Update Profile</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-shield-lock"></i> Change Password
                    </h5>
                </div>

                <div class="card-body">
                    <p class="small text-muted mb-3">Use a strong password with at least 6 characters.</p>

                    <form asp-action="ChangePassword" method="post" novalidate>
                        <div class="mb-3">
                            <label asp-for="ChangePassword.CurrentPassword" class="form-label"></label>
                            <span class="text-danger" aria-hidden="true">*</span>
                            <input asp-for="ChangePassword.CurrentPassword"
                                   class="form-control"
                                   autocomplete="current-password" type="password"
                                   required
                                   aria-required="true" />
                            <span asp-validation-for="ChangePassword.CurrentPassword" class="invalid-feedback d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ChangePassword.NewPassword" class="form-label"></label>
                            <span class="text-danger" aria-hidden="true">*</span>
                            <input asp-for="ChangePassword.NewPassword" type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   minlength="6"
                                   required
                                   aria-required="true" />
                            <span asp-validation-for="ChangePassword.NewPassword" class="invalid-feedback d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ChangePassword.ConfirmPassword" class="form-label"></label>
                            <span class="text-danger" aria-hidden="true">*</span>
                            <input asp-for="ChangePassword.ConfirmPassword" type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   required
                                   aria-required="true" />
                            <span asp-validation-for="ChangePassword.ConfirmPassword" class="invalid-feedback d-block"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Update Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
