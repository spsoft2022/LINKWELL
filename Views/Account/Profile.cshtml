@using LinkwellProductionSystem.ViewModels
@model ProfilePageVM

@{
    ViewData["Title"] = "Profile";
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            var errors = [];

            @foreach (var value in ViewData.ModelState.Values)
            {
                    foreach (var error in value.Errors)
                    {
                            <text>errors.push("@error.ErrorMessage");</text>
                    }
            }

            errors.forEach(function (msg) {
                toastr.error(msg);
            });


         
        });

           function previewImage(event) {

            const reader = new FileReader();

            reader.onload = function () {
            const output = document.getElementById('profilePreview');
            output.src = reader.result;
            };

            reader.readAsDataURL(event.target.files[0]);
            }

    </script>
}


<div class="profile-wrapper">

    <div class="profile-content">

        <!-- PROFILE CARD -->
        <div class="profile-card">

            <div class="profile-title">
                Profile Details
            </div>

            <div class="profile-details">

                <!-- Avatar -->
                <div class="profile-avatar">

                    <form asp-action="UploadProfileImage"
                          method="post"
                          enctype="multipart/form-data"
                          class="avatar-upload-form">
                        <div class="avatar-wrapper">

                            
                            <img id="profilePreview"
                                 src="@(!string.IsNullOrEmpty(Model.Profile.ProfileImagePath)
                                             ? Model.Profile.ProfileImagePath
                                             : "/images/Profileavator.png")"
                                 alt="Profile Image"
                                 class="avatar-img">


                            <label for="profileImageInput" class="avatar-camera">
                                <i class="bi bi-camera-fill"></i>
                            </label>

                            <input type="file"
                                   id="profileImageInput"
                                   name="ProfileImage"
                                   accept="image/*"
                                   hidden
                                   onchange="previewImage(event)">

                        </div>

                        <button type="submit" class="btn avatar-upload-btn">
                            Upload Photo
                        </button>

                    </form>

                </div>
                <!-- User Info -->
                <div class="profile-info">

                    <div class="profile-section-title">
                        Email Address
                    </div>

                    <div class="profile-email">
                        @Model.Profile.Email
                    </div>

                    <div class="profile-meta">
                        <div>
                            <span class="profile-section-title">User Name :</span> <br />
                            <span>@Model.Profile.UserName</span>
                        </div>
                        <div>
                            <span class="profile-section-title">Role :</span> <br />
                            <span>@Model.Profile.Role</span>
                        </div>
                    </div>

                </div>

            </div>

        </div>


        <!-- PASSWORD CARD -->
        <div class="password-section">

            <div class="profile-title">
                <i class="bi bi-shield-lock"></i> Change Password
            </div>

            <form asp-action="ChangePassword" method="post" novalidate>

                <div class="form-group">
                    <div class="d-flex">
                    <label asp-for="ChangePassword.CurrentPassword"></label>
                    <span class="required">*</span></div>

                    <input asp-for="ChangePassword.CurrentPassword"
                           type="password"
                           class="form-control"
                           autocomplete="current-password" />

                    <span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                     <div class="d-flex">
                    <label asp-for="ChangePassword.NewPassword"></label>
                    <span class="required">*</span>
                    </div>
                    <input asp-for="ChangePassword.NewPassword"
                           type="password"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="ChangePassword.NewPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                     <div class="d-flex">
                    <label asp-for="ChangePassword.ConfirmPassword"></label>
                    <span class="required">*</span>
                    </div>
                    <input asp-for="ChangePassword.ConfirmPassword"
                           type="password"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="ChangePassword.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn profile-btn">
                    UPDATE PASSWORD
                </button>

            </form>

        </div>

    </div>

</div>