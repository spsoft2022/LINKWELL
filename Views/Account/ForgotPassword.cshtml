@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="login-wrapper">

    <!-- LEFT BRANDING -->
    <div class="left-section">
        <div class="branding">
            <img src="~/images/logo.png" class="logo" />
            <h2 class="brand-title">Linkwell Telesystems</h2>
            <p class="brand-desc">
                An Instruction Display System in a MES provides real-time,
                step-by-step work instructions to operators on the shop floor.
            </p>
        </div>
    </div>

    <!-- RIGHT PASSWORD RESET -->
    <!-- RIGHT PASSWORD RESET -->
    <div class="right-section">
        <div class="forgot-card">

            <!-- Header -->
            <div class="forgot-header">
                <span class="forgot-small-text">To change password</span>

                <h2 class="forgot-title">
                    Password Reset
                </h2>

                <p class="forgot-subtext">
                    Please enter your email address to reset your password
                </p>
            </div>

            <!-- Form -->
            <form asp-action="ForgotPassword" method="post" class="forgot-form">

                <div class="forgot-form-group">
                    <label class="forgot-label">
                        Enter Email Address <span class="required">*</span>
                    </label>

                    <input name="Email"
                           type="email"
                           class="forgot-input"
                           placeholder="Email"
                           required />
                </div>

                <button type="submit" class="forgot-btn">
                    SEND DEFAULT PASSWORD
                </button>

            </form>

        </div>
    </div>
</div>

<footer class="login-footer">
    ©2025 VISIONTEK, Linkwell Telesystems Pvt. Ltd. | All Rights Reserved.
</footer>