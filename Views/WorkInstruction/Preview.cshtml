@{
    ViewData["Title"] = "Work Instruction Preview";
}
<style>
    .step-box {
        border-left: 6px solid #1976d2;
        margin-bottom: 15px;
        padding: 10px;
        background: #fff;
    }

        .step-box.mandatory {
            border-left-color: #d32f2f;
        }

    .step-header {
        font-weight: 600;
        margin-bottom: 8px;
        display: flex;
        justify-content: space-between;
    }

    .mandatory-badge {
        background: #d32f2f;
        color: #fff;
        padding: 2px 8px;
        font-size: 11px;
        border-radius: 3px;
    }

    .instruction-box {
        border: 1px solid #ddd;
        padding: 10px;
        margin-bottom: 8px;
        background: #f7f7f7;
        border-radius: 3px;
    }

    .instruction-title {
        font-weight: 600;
        margin-bottom: 4px;
    }
</style>

<div style="padding:15px">

    <!-- HEADER -->
    <div id="headerPanel">
        <div style="display:flex; gap:15px; align-items:end;">
            <div>
                <label>Model</label>
                <div id="ddlModel"></div>
            </div>
            <div>
                <label>Station</label>
                <div id="ddlStation"></div>
            </div>
        
            <div>
                <input type="button" id="btnLoad" value="Load Preview" />
            </div>
        </div>
    </div>

    <br />

    <!-- PREVIEW -->
    <div id="previewPanel"></div>

</div>

<script>
    $(document).ready(function () {
       
        $("#btnLoad").jqxButton({ width: 140, height: 32, theme: 'light' });
        $("#previewPanel").jqxPanel({ width: '100%', height: 600, theme: 'light' });

        loadDropdowns();
         loadVersions(modelId, stationId);
        $("#btnLoad").on("click", function () {
            const modelId = $("#ddlModel").jqxDropDownList('val');
            const stationId = $("#ddlStation").jqxDropDownList('val');

            if (!modelId || !stationId) {
                alert("Please select Model and Station");
                return;
            }

            loadPreview(modelId, stationId);
        });
    });

    /* ===============================
       LOAD PREVIEW
    ================================ */
    function loadPreview(modelId, stationId) {

        $("#previewPanel").jqxPanel('clearContent');
        $("#previewPanel").jqxPanel('append', '<div>Loading...</div>');

        $.ajax({
            url: `/api/workinstructions/preview?modelId=${modelId}&stationId=${stationId}`,
            type: "GET",
            success: function (data) {
                renderPreview(data);
            },
            error: function () {
                $("#previewPanel").jqxPanel('clearContent');
                $("#previewPanel").jqxPanel('append',
                    "<div style='color:red'>Failed to load preview</div>");
            }
        });
    }

    /* ===============================
       RENDER PREVIEW
    ================================ */
    function renderPreview(steps) {

        $("#previewPanel").jqxPanel('clearContent');

        if (!steps || steps.length === 0) {
            $("#previewPanel").jqxPanel('append', "<div>No instructions found</div>");
            return;
        }

        let html = "";

        steps.forEach(step => {

            const hasMandatory = step.instructions.some(x => x.isMandatory);

            html += `
                <div class="step-box ${hasMandatory ? 'mandatory' : ''}">
                    <div class="step-header">
                        <div>STEP ${step.sequenceNo}</div>
                        ${hasMandatory ? '<span class="mandatory-badge">MANDATORY</span>' : ''}
                    </div>
            `;

            step.instructions.forEach(inst => {
                html += renderInstruction(inst);
            });

            html += `</div>`;
        });

        $("#previewPanel").jqxPanel('append', html);
    }

    /* ===============================
       RENDER INSTRUCTION
    ================================ */
    function renderInstruction(inst) {

        let body = "";

        switch (inst.instructionType) {
            case "Text":
                body = `<p>${inst.instructionText}</p>`;
                break;

            case "Image":
                body = `<img src="${inst.attachmentPath}" style="max-width:100%" />`;
                break;

            case "PDF":
                body = `<iframe src="${inst.attachmentPath}" width="100%" height="450"></iframe>`;
                break;

            case "Video":
                body = `
                    <video controls width="100%">
                        <source src="${inst.attachmentPath}" type="video/mp4">
                    </video>`;
                break;

            default:
                body = `<span style="color:red">Unsupported type</span>`;
        }

        return `
            <div class="instruction-box">
                <div class="instruction-title">
                    ${inst.instructionType}
                    ${inst.isMandatory ? '<span class="mandatory-badge" style="margin-left:6px">Mandatory</span>' : ''}
                </div>
                ${body}
            </div>
        `;
    }

    /* ===============================
       LOAD DROPDOWNS
    ================================ */
    function loadDropdowns() {

        $.get('/api/model/get-models', function (data) {
            $("#ddlModel").jqxDropDownList({
                source: data,
                displayMember: "modelName",
                valueMember: "id",
                width: 250,
                height: 30,
                theme: 'light',
                placeHolder: "Select Model"
            });
        });

        $.get('/api/station/get-stations', function (data) {
            $("#ddlStation").jqxDropDownList({
                source: data.data,
                displayMember: "stationName",
                valueMember: "id",
                width: 250,
                height: 30,
                theme: 'light',
                placeHolder: "Select Station"
            });
        });


    }
</script>
