@{
    ViewData["Title"] = "Work Instruction Management";
}



<style>
    #instructionGrid {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        background-color: #fff;
    }

    #instructionGrid .jqx-grid-header {
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        font-weight: 600;
    }

    #instructionGrid .jqx-grid-cell {
        font-size: 0.95rem;
    }
</style>

<!-- ================= HEADER CONTROLS ================= -->
<div class="row align-items-end g-3 mb-3">

    <div class="col-md-3">
        <label class="form-label fw-semibold">Model</label>
        <div id="ddlModel"></div>
    </div>

    <div class="col-md-3">
        <label class="form-label fw-semibold">Station</label>
        <div id="ddlStation"></div>
    </div>

    <div class="col-md-3 pt-4">
        <input type="button" id="btnLoad" value="Load" />
    </div>

    <div class="col-md-3 pt-4 text-end">
        <input type="button" id="btnAdd" value="Add Instruction" />
    </div>

</div>

<!-- ================= GRID ================= -->
<div id="instructionGrid"></div>

<!-- ================= MODAL ================= -->
<div id="instructionWindow">
    <div>Add / Edit Instruction</div>
    <div style="padding:10px;">

        <input type="hidden" id="hdnId" />

        <label>Title</label>
        <input type="text" id="txtTitle" />

        <label class="mt-2">Instruction Type</label>
        <div id="ddlInstructionType"></div>

        <label class="mt-2">Content</label>
        <textarea id="txtContent"></textarea>

        <div class="mt-2" id="fileContainer" style="display:none;">
            <label>File Upload</label>
            <input type="file" id="fileInput" />
        </div>


        <label class="mt-2">Sequence</label>
        <input type="text" id="txtSequence" />

        <div class="mt-2" id="chkMandatory">Mandatory</div>
        <div class="mt-2" id="chkIsActive">Is Active</div>

        <label class="mt-2">Status</label>
        <div id="ddlStatus"></div>

        <br />
        <input type="button" id="btnSave" value="Save" />
        <input type="button" id="btnCancel" value="Cancel" />
    </div>
</div>


<script>
    let modelId = 0;
    let stationId = 0;

    $(document).ready(function () {


            $("#ddlInstructionType").on('select', function (event) {
            const type = event.args.item.label;

            if (type === "Text") {
            $("#txtContent").show();
            $("#fileContainer").hide();
            } else {
            $("#txtContent").hide();
            $("#fileContainer").show();

            if (type === "Image") $("#fileInput").attr("accept", "image/*");
            if (type === "PDF") $("#fileInput").attr("accept", "application/pdf");
            if (type === "Video") $("#fileInput").attr("accept", "video/*");
            }
            });


        /* ================= LOAD MODELS ================= */
        $.get("/api/model/get-models", function (data) {
            $("#ddlModel").jqxDropDownList({
                source: data,
                displayMember: "modelName",
                valueMember: "id",
                width: "100%",
                height: 30,
                placeHolder: "Select Model"
            });
        });

        /* ================= LOAD STATIONS ================= */
        $.get("/api/station/get-stations", function (res) {
            $("#ddlStation").jqxDropDownList({
                source: res.data,
                displayMember: "stationName",
                valueMember: "id",
                width: "100%",
                height: 30,
                placeHolder: "Select Station"
            });
        });

        /* ================= FORM CONTROLS ================= */
        $("#txtTitle").jqxInput({ width: "100%", height: 30 });

        $("#ddlInstructionType").jqxDropDownList({
            source: ["Text", "Image", "PDF", "Video"],
            width: "100%",
            height: 30,
            placeHolder: "Select Type"
        });

        $("#txtContent").jqxTextArea({ width: "100%", height: 100 });

        $("#txtSequence").jqxNumberInput({
            width: 200,
            height: 30,
            decimalDigits: 0,
            spinButtons: true,
            min: 1
        });

        $("#chkMandatory").jqxCheckBox({ width: 120 });
        $("#chkIsActive").jqxCheckBox({ width: 120, checked: true });

        $("#ddlStatus").jqxDropDownList({
            source: ["Draft", "Published"],
            width: 200,
            height: 30,
            selectedIndex: 0
        });

        /* ================= BUTTONS ================= */
        $("#btnLoad, #btnAdd, #btnSave, #btnCancel").jqxButton({ height: 30 });

        /* ================= WINDOW ================= */
        $("#instructionWindow").jqxWindow({
            width: 560,
            height: 520,
            isModal: true,
            autoOpen: false,
            resizable: false
        });

        /* ================= GRID INIT ================= */
        initGrid();

        /* ================= EVENTS ================= */
        $("#btnLoad").click(loadInstructions);

        $("#btnAdd").click(function () {
            clearForm();
                  $("#hdnId").val("");   // 👈 reset edit mode
            $("#instructionWindow").jqxWindow("open");
        });

        $("#btnCancel").click(function () {
            $("#instructionWindow").jqxWindow("close");
        });

        $("#btnSave").click(saveInstruction);
    });


    function editInstruction(rowIndex) {

    const row = $("#instructionGrid").jqxGrid("getrowdata", rowIndex);
    if (!row) return;

    // store id (IMPORTANT)
    $("#hdnId").val(row.id);

    $("#txtTitle").val(row.title);
    $("#txtSequence").jqxNumberInput("val", row.sequenceNo);

    $("#chkMandatory").jqxCheckBox(row.isMandatory ? "check" : "uncheck");
    $("#chkIsActive").jqxCheckBox(row.isActive ? "check" : "uncheck");

    $("#ddlStatus").jqxDropDownList("selectItem", row.status);
    $("#ddlInstructionType").jqxDropDownList("selectItem", row.instructionType);

    // Handle content based on type
    if (row.instructionType === "Text") {
        $("#txtContent").show();
        $("#fileContainer").hide();
        $("#txtContent").val(row.content);
    } else {
        $("#txtContent").hide();
        $("#fileContainer").show();
        $("#fileInput").val(""); // cannot set file programmatically
    }

    $("#instructionWindow").jqxWindow("open");
}



    /* ================= GRID ================= */
      function initGrid() {

        const source = {
            datatype: "json",
            localdata: [],
            datafields: [
                { name: "id", type: "number" },
                { name: "sequenceNo", type: "number" },
                { name: "title", type: "string" },
                { name: "instructionType", type: "string" },
                { name: "content", type: "string" },
                { name: "isActive", type: "bool" },
                { name: "isMandatory", type: "bool" },
                { name: "status", type: "string" },
                { name: "versionNo", type: "number" }
            ]
        };

        const adapter = new $.jqx.dataAdapter(source);

        window.LinkwellGrid.create("#instructionGrid", {
            autoheight: true,
            source: adapter,
            filterable: false,
            columns: [
                { text: "Seq", datafield: "sequenceNo", width: 60 },
                { text: "Title", datafield: "title", width: 180 },
                { text: "Type", datafield: "instructionType", width: 100 },
               {
                text: "Content",
                datafield: "content",
                minwidth: 250,
                filterable: false,
                sortable: false,
                cellsrenderer: imagerenderer
                },
                {
                    text: "Mandatory",
                    datafield: "isMandatory",
                    columntype: "checkbox",
                    width: 100
                },
                {
                    text: "Active",
                    datafield: "isActive",
                    columntype: "checkbox",
                    width: 80
                },

                { text: "Status", datafield: "status", width: 100 },

                { text: "Version", datafield: "versionNo", width: 80 },
                {
                text: "Edit",
                width: 70,
                cellsrenderer: function (row) {
                return `
                <button class="btn btn-sm btn-primary"
                onclick="editInstruction(${row})">
                Edit
                </button>`;
                }
                }
            ]
        });
    }



        var imagerenderer = function (row, columnfield, value, defaulthtml, columnproperties, rowdata) {

        const type = rowdata["instructionType"];
        if (type === "Image")
        return `<img src='${value}' width='50' height='50' style='margin-left:1px;' />`;

        if (type === "PDF")
        return `<a href='${value}' target='_blank'>Open PDF</a>`;

        if (type === "Video")
        return `<video width='120' controls src='${value}'></video>`;

        return value || "";
        }
 

    /* ================= LOAD DATA ================= */
    function loadInstructions() {

        const modelItem = $("#ddlModel").jqxDropDownList("getSelectedItem");
        const stationItem = $("#ddlStation").jqxDropDownList("getSelectedItem");

        if (!modelItem || !stationItem) {
            alert("Please select Model and Station");
            return;
        }

        modelId = modelItem.value;
        stationId = stationItem.value;

        $.get("/api/admin/work-instructions/by-model-station",
            { modelId, stationId },
            function (res) {

                  const base = window.location.origin; // auto-detects http://localhost:7207
                  
        res = res.map(x => {
            if (x.content && x.instructionType == "Image") {
                x.content = base + x.content;  // build full URL
            }
            return x;
        });

                const source = {
                    datatype: "json",
                    localdata: res,
                    datafields: $("#instructionGrid").jqxGrid("source")._source.datafields
                };
                $("#instructionGrid").jqxGrid({ source: new $.jqx.dataAdapter(source) });
            });
    }

    /* ================= SAVE ================= */
       function saveInstruction() {

        const type = $("#ddlInstructionType").jqxDropDownList("getSelectedItem")?.label;

    function doSave(contentUrl) {

        const id = $("#hdnId").val();
        const type = $("#ddlInstructionType").jqxDropDownList("getSelectedItem")?.label;

        let data;
        let url;

        if (id) {
            // ============================
            // UPDATE PAYLOAD
            // ============================
            data = {
                modelStationWorkInstructionId: parseInt(id),
                title: $("#txtTitle").val(),
                instructionType: type,
                content: contentUrl,
                isActive: $("#chkIsActive").jqxCheckBox("checked"),
                sequenceNo: $("#txtSequence").jqxNumberInput("val"),
                isMandatory: $("#chkMandatory").jqxCheckBox("checked"),
                status: $("#ddlStatus").jqxDropDownList("getSelectedItem")?.label,
                modifiedBy: "admin",
                      versionNo: 1
            };

            url = "/api/admin/work-instructions/update";
        } else {
            // ============================
            // ADD PAYLOAD
            // ============================
            data = {
                title: $("#txtTitle").val(),
                instructionType: type,
                content: contentUrl,
                isActive: $("#chkIsActive").jqxCheckBox("checked"),
                modelId: modelId,
                stationId: stationId,
                sequenceNo: $("#txtSequence").jqxNumberInput("val"),
                isMandatory: $("#chkMandatory").jqxCheckBox("checked"),
                versionNo: 1,
                status: $("#ddlStatus").jqxDropDownList("getSelectedItem")?.label,
                createdBy: "admin"
            };

            url = "/api/admin/work-instructions/add";
        }

        $.ajax({
            url: url,
                type: id ? "POST" : "POST",   // 🔥 important
            contentType: "application/json",
            data: JSON.stringify(data),
            success: () => {
                $("#instructionWindow").jqxWindow("close");
                loadInstructions();
            },
            error: (err) => {
                console.error(err);
                alert("Save failed. Check console.");
            }
        });
    }

        // TEXT path
        if (type === "Text") {
            doSave($("#txtContent").val());
            return;
        }

        // FILE path
        const file = $("#fileInput")[0].files[0];
        if (!file) {
            alert("Select file first!");
            return;
        }

        const formData = new FormData();
        formData.append("file", file);

        // Upload file first
        $.ajax({
            url: "/api/admin/work-instructions/upload",
            type: "POST",
            data: formData,
            contentType: false,
            processData: false,
            success: res => doSave(res.relativePath),
            error: () => alert("Upload failed")
        });
    }

    /* ================= CLEAR ================= */
    function clearForm() {
        $("#txtTitle").val("");
        $("#txtContent").val("");
        $("#txtSequence").jqxNumberInput("val", 1);
        $("#ddlInstructionType").jqxDropDownList("clearSelection");
        $("#ddlStatus").jqxDropDownList("selectIndex", 0);
        $("#chkMandatory").jqxCheckBox("uncheck");
        $("#chkIsActive").jqxCheckBox("check");
    }
</script>
