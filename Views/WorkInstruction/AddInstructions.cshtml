@{
    ViewData["Title"] = "Work Instruction Management";
}

<link rel="stylesheet" href="~/css/common.css" />


<div class="org-container">

    <div class="org-header">
        <div class="left">
            <div>
                <img src="/images/menuicons/instructions.svg" class="icon" />
            </div>
            <span class="icontext">Add Instructions</span>
        </div>

        <button class="add-btn"
                id="btnAdd">
            + Add New
        </button>
    </div>

    <div class="row align-items-end g-3 mb-3">

        <div class="col-md-6 d-flex align-items-center gap-2">
            <label class="form-label mb-0">Model</label>
            <div id="ddlModel" class="flex-grow-1"></div>
        </div>

        <div class="col-md-6 d-flex align-items-center gap-2">
            <label class="form-label mb-0">Station</label>
            <div id="ddlStation" class="flex-grow-1"></div>
        </div>

    </div>

    <div id="instructionGrid" class="org-table"></div>

</div>





<div id="instructionWindow">
    <div>Work Instruction Editor</div>
    <div style="padding:10px;">
        <input type="hidden" id="hdnId" />
        <input type="hidden" id="modeleditId" />
        <input type="hidden" id="stationeditId" />
        <input type="hidden" id="version" />

        <div id="editor" style="border:1px solid #ccc; min-height:350px;"></div>

        <div class="mt-3">
            <label>Status</label>
            <div id="ddlStatus"></div>
        </div>

        <br />
        <input type="button" id="btnSave" value="Save" />
        <input type="button" id="btnCancel" value="Cancel" />
    </div>
</div>

<div id="toastMsg">Please select Model and Station</div>

<script>

    let quill = null;

    $(document).ready(function () {

        //-----------------------------
        // UI INIT
        //-----------------------------

        $("#toastMsg").jqxNotification({
            width: 300,
            position: "top-right",
            autoClose: true,
            autoCloseDelay: 2500,
            template: "warning"
        });

        $("#btnAdd, #btnSave, #btnCancel").jqxButton({ height: 30 });

        $("#instructionWindow").jqxWindow({
            width: 900,
            height: 650,
            isModal: true,
            autoOpen: false
        });

        $("#ddlStatus").jqxDropDownList({
            source: ["Draft", "Published"],
            width: 200,
            height: 30,
            selectedIndex: 0
        });

        //-----------------------------
        // LOAD DROPDOWNS
        //-----------------------------

        $.get("/api/model/get-models", data => {
            $("#ddlModel").jqxDropDownList({
                source: data,
                displayMember: "modelName",
                valueMember: "id",
                width: "100%",
                height: 30,
                placeHolder: "Select Model"
            });
        });

        $.get("/api/station/get-stations", res => {
            $("#ddlStation").jqxDropDownList({
                source: res.data,
                displayMember: "stationName",
                valueMember: "id",
                width: "100%",
                height: 30,
                placeHolder: "Select Station"
            });
        });

        //-----------------------------
        // QUILL INIT (STABLE)
        //-----------------------------

           quill = new Quill('#editor', {
        theme: 'snow',
        modules: {
            toolbar: {
                container: [
                    ['bold', 'italic', 'underline'],
                    [{ color: [] }],
                    [{ size: ['small', false, 'large', 'huge'] }],
                    [{ list: 'ordered' }, { list: 'bullet' }],
                    ['image'],   // IMAGE BUTTON
                    ['clean']
                ],
                handlers: {
                    image: imageHandler
                }
            }
        }
    });


        console.log("Quill Ready");

        //-----------------------------
        // BUTTON EVENTS
        //-----------------------------

        $("#btnAdd").click(function () {

            const modelItem = $("#ddlModel").jqxDropDownList("getSelectedItem");
            const stationItem = $("#ddlStation").jqxDropDownList("getSelectedItem");

            if (!modelItem || !stationItem) {
                $("#toastMsg").text("Please select Model and Station").jqxNotification("open");
                return;
            }

            $("#hdnId").val("");

            // Clear editor
            quill.root.innerHTML = "";

            $("#instructionWindow").jqxWindow("open");
        });

        $("#btnCancel").click(() => {
            $("#instructionWindow").jqxWindow("close");
        });

        $("#btnSave").click(saveInstruction);

        loadInstructions();

    });

    function imageHandler() {

    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.click();

    input.onchange = () => {

        const file = input.files[0];
        if (!file) return;

        const reader = new FileReader();

        reader.onload = () => {

            const range = quill.getSelection();
            quill.insertEmbed(range.index, 'image', reader.result);

        };

        reader.readAsDataURL(file);
    };
}


    //--------------------------------------
    // LOAD GRID
    //--------------------------------------

    function loadInstructions() {

        $.get("/api/admin/work-instructions/getInstructions", res => {

            const source = {
                datatype: "json",
                localdata: res,
                datafields: [
                    { name: "id", type: "number" },
                    { name: "modelId", type: "number" },
                    { name: "modelName", type: "string" },
                    { name: "stationId", type: "number" },
                    { name: "stationName", type: "string" },
                    { name: "htmlContent", type: "string" },
                    { name: "status", type: "string" },
                    { name: "version", type: "number" }
                ]
            };

            const adapter = new $.jqx.dataAdapter(source);

            window.LinkwellGrid.create("#instructionGrid", {
            width: "100%",          // ✅ Stretch to container width
            autoheight: true,
            columnsresize: true,    // ✅ Important for % resizing
            scrollmode: "logical",  // ✅ Prevent weird horizontal scroll

            source: adapter,

            columns: [
            { text: "ID", datafield: "id", width: "8%" },
            { text: "Model", datafield: "modelName", width: "20%" },
            { text: "Station", datafield: "stationName", width: "20%" },
            { text: "Version", datafield: "version", width: "10%" },
            { text: "Status", datafield: "status", width: "12%" },
            {
            text: "Edit",
            width: "15%",
            cellsrenderer: row =>
            `<button class="btn btn-sm btn-primary w-100"
            onclick="editInstruction(${row})">Edit</button>`
            },
            {
            text: "Preview",
            width: "15%",
            cellsrenderer: row =>
            `<button class="btn btn-sm btn-secondary w-100"
            onclick="previewInstruction(${row})">Preview</button>`
            }
            ]
            });

            });
            }


    //--------------------------------------
    // EDIT
    //--------------------------------------

    function editInstruction(rowIndex) {

        const row = $("#instructionGrid").jqxGrid("getrowdata", rowIndex);
        if (!row) return;

        $("#hdnId").val(row.id);
        $("#modeleditId").val(row.modelId);
        $("#stationeditId").val(row.stationId);
        $("#version").val(row.version);

        $("#instructionWindow").jqxWindow("open");

        // Set HTML safely
        setTimeout(() => {
            quill.root.innerHTML = row.htmlContent || "";
        }, 100);

        $("#ddlStatus").jqxDropDownList("selectItem", row.status);
    }


    //--------------------------------------
    // PREVIEW
    //--------------------------------------

    function previewInstruction(rowIndex) {

        const row = $("#instructionGrid").jqxGrid("getrowdata", rowIndex);

        window.open(
            `/floor-preview?station=${row.stationId}&model=${row.modelId}&versionNo=${row.version}`,
            '_blank'
        );
    }


    //--------------------------------------
    // SAVE
    //--------------------------------------

    function saveInstruction() {

        const id = $("#hdnId").val();

        let modelId, stationId, version;

        if (id) {

            modelId = $("#modeleditId").val();
            stationId = $("#stationeditId").val();
            version = $("#version").val();

        } else {

            const modelItem = $("#ddlModel").jqxDropDownList("getSelectedItem");
            const stationItem = $("#ddlStation").jqxDropDownList("getSelectedItem");

            if (!modelItem || !stationItem) {
                $("#toastMsg").text("Please select Model and Station").jqxNotification("open");
                return;
            }

            modelId = modelItem.value;
            stationId = stationItem.value;
            version = 1;
        }

        const htmlContent = quill.root.innerHTML;

        if (!htmlContent.trim()) {
            alert("Instruction content is empty");
            return;
        }

        const payload = {
            id: id ? parseInt(id) : 0,
            htmlContent: htmlContent,
            status: $("#ddlStatus").jqxDropDownList("getSelectedItem")?.label,
            modelId,
            stationId,
            createdBy: "admin",
            versionNo: version
        };

        const url = id
            ? "/api/admin/work-instructions/update"
            : "/api/admin/work-instructions/add";

        $.ajax({
            url,
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: () => {
                $("#instructionWindow").jqxWindow("close");
                loadInstructions();
            },
            error: err => console.error(err)
        });
    }

</script>
