@{
    ViewData["Title"] = "Assign Model to Station (Production Run)";
}

<div class="row g-3 mt-2">
    <div class="col-md-4">
        <label class="fw-bold">Station</label>
        <div id="ddlStation"></div>
    </div>

    <div class="col-md-4">
        <label class="fw-bold">Model</label>
        <div id="ddlModel"></div>
    </div>

    <div class="col-md-3 align-self-end">
        <button id="btnAssign" class="btn btn-primary w-100">
            Start Run
        </button>
    </div>
</div>

<hr class="my-3" />

<h5 class="fw-semibold">Active Running Assignments</h5>
<div id="assignmentGrid"></div>

<script>

    // ============================================================
    // LOAD GRID
    // ============================================================
    function loadAssignments() {


        $("#assignmentGrid").on('rowdoubleclick', function (event) {
        $("#btnPreview").click();
        });


        $.get('/api/admin/assignments', function (data) {

            const source = {
                datatype: "json",
                localdata: data
            };

            const adapter = new $.jqx.dataAdapter(source);

            $("#assignmentGrid").jqxGrid({
                width: 800,
                autoheight: true,
                source: adapter,
                 selectionmode: 'singlerow',
                showtoolbar: true,
                rendertoolbar: function (toolbar) {
                let container = $("<div style='margin: 5px; display:flex; gap:10px;'></div>");
                toolbar.append(container);

                let btnPreview = $("<input type='button' id='btnPreview' value='Preview' />");
                container.append(btnPreview);

                btnPreview.jqxButton({ width: 90, height: 28 });

                btnPreview.on('click', function () {
                let rowIndex = $("#assignmentGrid").jqxGrid('getselectedrowindex');
                if (rowIndex === -1) {
                    toastr.warning("Select a running assignment to preview");
                    return;
                }

                let row = $("#assignmentGrid").jqxGrid('getrowdata', rowIndex);

                window.open(`/floor-preview?station=${row.stationId}&model=${row.modelId}`, "_blank");
                });
                },
                columns: [
                    { text: "Station", datafield: "stationName", width: 330 },
                    { text: "Model", datafield: "modelName", width: 230 },
                    { text: "Updated", datafield: "updatedAt", width: 250 },
                    { datafield: "stationId", hidden: true },
                    { datafield: "modelId", hidden: true }
                ]
            });
        });
    }

    // ============================================================
    // LOAD MODELS DROPDOWN
    // ============================================================
    function loadModels() {
        $.get('/api/model/get-models', function (data) {

            $("#ddlModel").jqxDropDownList({
                source: data,
                displayMember: "modelName",
                valueMember: "id",
                width: 250,
                height: 30,
                placeHolder: "Select Model"
            });
        });
    }

    // ============================================================
    // LOAD STATIONS DROPDOWN
    // ============================================================
    function loadStations() {
        $.get('/api/station/get-stations', function (res) {

            $("#ddlStation").jqxDropDownList({
                source: res.data,
                displayMember: "stationCode",
                valueMember: "id",
                width: 250,
                height: 30,
                placeHolder: "Select Station"
            });
        });
    }

    // ============================================================
    // ON READY
    // ============================================================
    $(document).ready(function () {

        loadModels();
        loadStations();
        loadAssignments();

        // ========================================================
        // ASSIGN STATION => MODEL
        // ========================================================
        $("#btnAssign").on("click", function () {

            const stationId = $("#ddlStation").jqxDropDownList('val');
            const modelId = $("#ddlModel").jqxDropDownList('val');

            if (!stationId || !modelId) {
                toastr.error("Select both station & model");
                return;
            }

            $.ajax({
                url: '/api/admin/assignments',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ stationId, modelId }),
                success: function () {
                    toastr.success("Assigned successfully");
                    loadAssignments();
                }
            });
        });
    });

</script>
