@{
    ViewData["Title"] = "Station Management";
}

<link rel="stylesheet" href="~/css/common.css" />

<div class="org-container">

    <div class="org-header">
        <div class="left">
            <div>
                <img src="/images/menuicons/stations.svg" class="icon" />
            </div>
            <span class="icontext">Stations</span>
        </div>


        <button class="add-btn"
                id="btnAddStation">
            + Add New
        </button>
    </div>

    <div id="stationGrid" class="org-table"></div>
</div>

<div class="modal fade" id="stationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Add Station</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="stationId">
                <p class="small text-muted mb-3">Fields marked with <span class="text-danger" aria-hidden="true">*</span> are required.</p>

                <div class="mb-2">
                    <label for="stationCode">Station Code <span class="text-danger" aria-hidden="true">*</span></label>
                    <input type="text" class="form-control" id="stationCode" required aria-required="true">
                </div>

                <div class="mb-2">
                    <label for="stationName">Station Name <span class="text-danger" aria-hidden="true">*</span></label>
                    <input type="text" class="form-control" id="stationName" required aria-required="true">
                </div>

                <div class="mb-2">
                    <label for="description">Description</label>
                    <textarea class="form-control" id="description"></textarea>
                </div>

                <div class="mb-2">
                    <label for="location">Location</label>
                    <input type="text" class="form-control" id="location">
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-success" id="btnSaveStation">Save</button>
            </div>

        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
    loadStationGrid();
    });

    $("#btnAddStation").click(function () {
    clearStationForm();
    var modal = new bootstrap.Modal(document.getElementById('stationModal'));
    modal.show();

    });


    function editStation(rowIndex) {

    const rowData = $("#stationGrid").jqxGrid('getrowdata', rowIndex);

    $("#stationId").val(rowData.id);
    $("#stationCode").val(rowData.stationCode);
    $("#stationName").val(rowData.stationName);
    $("#description").val(rowData.description);
    $("#location").val(rowData.location);

    $(".modal-title").text("Edit Station");

    var modal = new bootstrap.Modal(document.getElementById('stationModal'));
    modal.show();
}


    function clearStationForm() {
         $("#stationId").val("");
        $("#stationCode").val("");
        $("#stationName").val("");
        $("#description").val("");
        $("#location").val("");
    }

            $("#btnSaveStation").click(function () {

                const id = $("#stationId").val();

                const data = {
                stationId: id ? parseInt(id) : null,
                stationCode: $("#stationCode").val().trim(),
                stationName: $("#stationName").val().trim(),
                description: $("#description").val(),
                location: $("#location").val()
                };

                if (!data.stationCode || !data.stationName) {
                toastr.error("Station Code and Station Name are required");
                return;
                }

                $.ajax({
                url: "/api/station/save",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function (res) {
                toastr.success(res.message);
                $("#stationModal").modal("hide");
                $("#stationGrid").jqxGrid('updatebounddata');
                clearStationForm();
                },
                    error: function (xhr) {
        let msg = "Save failed";

        if (xhr.responseJSON) {
            const res = xhr.responseJSON;

            // ASP.NET validation format
            if (res.errors) {
                // Flatten first error
                const allErrors = [];
                for (let key in res.errors) {
                    allErrors.push(...res.errors[key]);
                }
                msg = allErrors.join("<br/>");
            }
            else if (res.message) {
                msg = res.message;
            }
        }

        toastr.error(msg);
    }


                });

         
            });

            function toggleStation(stationId, isActive) {

            const action = isActive ? "disable" : "enable";

            if (!confirm(`Are you sure you want to ${action} this station?`))
            return;

            $.ajax({
            url: "/api/station/toggle-status",
            type: "PUT",
            contentType: "application/json",
            data: JSON.stringify({
            stationId: stationId,
            isActive: !isActive
            }),
            success: function (res) {
            if (res.success) {
            toastr.success(res.message);
            $("#stationGrid").jqxGrid('updatebounddata');
            } else {
            toastr.error(res.message);
            }
            },
            error: function () {
            toastr.error("Status update failed");
            }
            });
            }


    function loadStationGrid() {

        var source = {
            datatype: "json",
                url: "/api/station/get-stations",
            root: "data",
            datafields: [
                { name: "id", type: "number" },
                { name: "stationCode", type: "string" },
                { name: "stationName", type: "string" },
                { name: "description", type: "string" },
                { name: "location", type: "string" },
                { name: "isActive", type: "bool" }
            ]
        };

        var adapter = new $.jqx.dataAdapter(source);

          window.LinkwellGrid.create("#stationGrid", {

        width: "100%",
        autoheight: true,
        source: adapter,

        columnsresize: true,
        columnsreorder: true,
        scrollmode: "logical",

        columns: [
            {
                text: "Code",
                datafield: "stationCode",
                width: "12%"
            },

            {
                text: "Name",
                datafield: "stationName",
                width: "18%"
            },

            {
                text: "Description",
                datafield: "description",
                width: "28%"
            },

            {
                text: "Location",
                datafield: "location",
                width: "15%"
            },

            {
                text: "Status",
                datafield: "isActive",
                width: "10%",
                align: "center",
                cellsalign: "center",
                cellsrenderer: function (row, col, val) {
                    return val
                        ? "<div class='status-pill active w-100 text-center'>Active</div>"
                        : "<div class='status-pill disabled w-100 text-center'>Disabled</div>";
                }
            },

            {
                text: "Actions",
                width: "17%",   // increased to prevent button overflow
                filterable: false,
                sortable: false,
                cellsalign: "center",
                cellsrenderer: function (row) {

                    const data = $("#stationGrid")
                        .jqxGrid('getrowdata', row);

                    const toggleText = data.isActive ? "Disable" : "Enable";
                    const toggleClass = data.isActive
                        ? "btn-danger"
                        : "btn-success";

                    return `
                        <div class="d-flex justify-content-center gap-1 w-100">
                            <button class="btn btn-sm btn-outline-primary flex-fill"
                                onclick="editStation(${row})">
                                Edit
                            </button>

                            <button class="btn btn-sm ${toggleClass} flex-fill"
                                onclick="toggleStation(${data.id}, ${data.isActive})">
                                ${toggleText}
                            </button>
                        </div>
                    `;
                }
            }
        ]
    });

    }

</script>
