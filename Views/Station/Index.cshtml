@{
    ViewData["Title"] = "Station Management";
}


<button class="btn btn-primary mb-3" id="btnAddStation">
    ➕ Add Station
</button>

<style>
    #stationGrid {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        background-color: #fff;
    }

    #stationGrid .jqx-grid-header {
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        font-weight: 600;
    }

    #stationGrid .jqx-grid-cell {
        font-size: 0.95rem;
    }

    .status-pill {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
        line-height: 1.4;
    }

    .status-pill.active {
        color: #0a7d2c;
        background-color: #e8f7ed;
    }

    .status-pill.disabled {
        color: #a21f2d;
        background-color: #fbe9eb;
    }
</style>

<div id="stationGrid"></div>

<div class="modal fade" id="stationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Add Station</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="stationId">
                <p class="small text-muted mb-3">Fields marked with <span class="text-danger" aria-hidden="true">*</span> are required.</p>

                <div class="mb-2">
                    <label for="stationCode">Station Code <span class="text-danger" aria-hidden="true">*</span></label>
                    <input type="text" class="form-control" id="stationCode" required aria-required="true">
                </div>

                <div class="mb-2">
                    <label for="stationName">Station Name <span class="text-danger" aria-hidden="true">*</span></label>
                    <input type="text" class="form-control" id="stationName" required aria-required="true">
                </div>

                <div class="mb-2">
                    <label for="description">Description</label>
                    <textarea class="form-control" id="description"></textarea>
                </div>

                <div class="mb-2">
                    <label for="location">Location</label>
                    <input type="text" class="form-control" id="location">
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-success" id="btnSaveStation">Save</button>
            </div>

        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
    loadStationGrid();
    bindStationGridResizeEvents();
    });

    $("#btnAddStation").click(function () {
    clearStationForm();
    var modal = new bootstrap.Modal(document.getElementById('stationModal'));
    modal.show();

    });


    function editStation(rowIndex) {

    const rowData = $("#stationGrid").jqxGrid('getrowdata', rowIndex);

    $("#stationId").val(rowData.id);
    $("#stationCode").val(rowData.stationCode);
    $("#stationName").val(rowData.stationName);
    $("#description").val(rowData.description);
    $("#location").val(rowData.location);

    $(".modal-title").text("Edit Station");

    var modal = new bootstrap.Modal(document.getElementById('stationModal'));
    modal.show();
}


    function clearStationForm() {
         $("#stationId").val("");
        $("#stationCode").val("");
        $("#stationName").val("");
        $("#description").val("");
        $("#location").val("");
    }

            $("#btnSaveStation").click(function () {

                const id = $("#stationId").val();

                const data = {
                stationId: id ? parseInt(id) : null,
                stationCode: $("#stationCode").val().trim(),
                stationName: $("#stationName").val().trim(),
                description: $("#description").val(),
                location: $("#location").val()
                };

                if (!data.stationCode || !data.stationName) {
                toastr.error("Station Code and Station Name are required");
                return;
                }

                $.ajax({
                url: "/api/station/save",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function (res) {
                toastr.success(res.message);
                $("#stationModal").modal("hide");
                $("#stationGrid").jqxGrid('updatebounddata');
                clearStationForm();
                },
                    error: function (xhr) {
        let msg = "Save failed";

        if (xhr.responseJSON) {
            const res = xhr.responseJSON;

            // ASP.NET validation format
            if (res.errors) {
                // Flatten first error
                const allErrors = [];
                for (let key in res.errors) {
                    allErrors.push(...res.errors[key]);
                }
                msg = allErrors.join("<br/>");
            }
            else if (res.message) {
                msg = res.message;
            }
        }

        toastr.error(msg);
    }


                });

         
            });

            function toggleStation(stationId, isActive) {

            const action = isActive ? "disable" : "enable";

            if (!confirm(`Are you sure you want to ${action} this station?`))
            return;

            $.ajax({
            url: "/api/station/toggle-status",
            type: "PUT",
            contentType: "application/json",
            data: JSON.stringify({
            stationId: stationId,
            isActive: !isActive
            }),
            success: function (res) {
            if (res.success) {
            toastr.success(res.message);
            $("#stationGrid").jqxGrid('updatebounddata');
            } else {
            toastr.error(res.message);
            }
            },
            error: function () {
            toastr.error("Status update failed");
            }
            });
            }


    function loadStationGrid() {

        var source = {
            datatype: "json",
                url: "/api/station/get-stations",
            root: "data",
            datafields: [
                { name: "id", type: "number" },
                { name: "stationCode", type: "string" },
                { name: "stationName", type: "string" },
                { name: "description", type: "string" },
                { name: "location", type: "string" },
                { name: "isActive", type: "bool" }
            ]
        };

        var adapter = new $.jqx.dataAdapter(source);

        $("#stationGrid").jqxGrid({
            width: "100%",
            autoheight: true,
            source: adapter,
            pageable: true,
            sortable: true,
            filterable: true,
            showfilterrow: true,
            columnsresize: true,
            rowsheight: 44,
            columnsheight: 40,
            altrows: true,
            columns: [
                { text: "Code", datafield: "stationCode", width: "12%" },
                { text: "Name", datafield: "stationName", width: "20%" },
                { text: "Description", datafield: "description", width: "33%" },
                { text: "Location", datafield: "location", width: "16%" },
                {
                    text: "Status",
                    datafield: "isActive",
                    width: "9%",
                    cellsrenderer: function (row, col, val) {
                        return val
                            ? "<span class='status-pill active'>Active</span>"
                            : "<span class='status-pill disabled'>Disabled</span>";
                    }
                },
                {
                text: "Actions",
                width: "10%",
                cellsrenderer: function (row) {

                const data = $("#stationGrid").jqxGrid('getrowdata', row);
                const toggleText = data.isActive ? "Disable" : "Enable";
                const toggleClass = data.isActive ? "btn-danger" : "btn-success";

                return `
                <button class="btn btn-sm btn-outline-primary me-1"
                onclick="editStation(${row})">
                Edit
                </button>

                <button class="btn btn-sm ${toggleClass}"
                onclick="toggleStation(${data.id}, ${data.isActive})">
                ${toggleText}
                </button>
                `;
                },
                filterable: false,
                sortable: false
                }


            ]
        });
    }

    function refreshStationGridLayout() {
        if (!$("#stationGrid").data("jqxGrid")) {
            return;
        }

        $("#stationGrid").jqxGrid("render");
        $("#stationGrid").jqxGrid("autoresizecolumns", "cells");
    }

    function bindStationGridResizeEvents() {
        $(window).on("resize", function () {
            refreshStationGridLayout();
        });

        window.addEventListener("sidebar:toggled", function () {
            setTimeout(refreshStationGridLayout, 280);
        });
    }
</script>
