@{
    ViewData["Title"] = "Category Management";
}
<link rel="stylesheet" href="~/css/common.css" />

<div class="org-container">

    <div class="org-header">
        <div class="left">
            <div >
                <img src="/images/menuicons/category.svg" class="icon" />
            </div>
            <span class="icontext">Category</span>
        </div>


        <button class="add-btn"
            id="btnAddCategory">
            + Add New
        </button>
    </div>

 


    <div id="categoryGrid" class="org-table"></div>
</div>


<!-- MODAL -->
<div class="modal fade" id="categoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Add Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="categoryId">
                <p class="small text-muted mb-3">Fields marked with <span class="text-danger" aria-hidden="true">*</span> are required.</p>

                <div class="mb-2">
                    <label for="categoryCode">Category Code <span class="text-danger" aria-hidden="true">*</span></label>
                    <input type="text" class="form-control" id="categoryCode" required aria-required="true">
                </div>

                <div class="mb-2">
                    <label for="categoryName">Category Name <span class="text-danger" aria-hidden="true">*</span></label>
                    <input type="text" class="form-control" id="categoryName" required aria-required="true">
                </div>

                <div class="mb-2">
                    <label for="categoryDescription">Description</label>
                    <textarea class="form-control" id="categoryDescription"></textarea>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button class="btn btn-success" id="btnSaveCategory">
                    Save
                </button>
            </div>

        </div>
    </div>
</div>

<script>

    $(document).ready(function () {
        loadCategoryGrid();
    });

    let categoryModal;

    /* ---------------- ADD CATEGORY ---------------- */

    $("#btnAddCategory").click(function () {

        clearCategoryForm();

        $(".modal-title").text("Add Category");

        $("#categoryCode").prop("disabled", false);

        categoryModal = new bootstrap.Modal(
            document.getElementById('categoryModal')
        );

        categoryModal.show();
    });

    /* ---------------- EDIT CATEGORY ---------------- */

    function editCategory(rowIndex) {

        const rowData = $("#categoryGrid").jqxGrid('getrowdata', rowIndex);

        $("#categoryId").val(rowData.categoryId);
        $("#categoryCode").val(rowData.categoryCode);
        $("#categoryName").val(rowData.categoryName);
        $("#categoryDescription").val(rowData.description);

        $(".modal-title").text("Edit Category");

        var modal = new bootstrap.Modal(document.getElementById('categoryModal'));
        modal.show();
    }

    /* ---------------- CLEAR FORM ---------------- */

    function clearCategoryForm() {

        $("#categoryId").val("");
        $("#categoryCode").val("");
        $("#categoryName").val("");
        $("#categoryDescription").val("");
    }

    /* ---------------- SAVE CATEGORY ---------------- */

    $("#btnSaveCategory").on("click", function () {

            let data;

            let catid= $("#categoryId").val().trim();

    if (catid) {
        // UPDATE
        data = {
            CategoryId: parseInt(catid),
            CategoryCode: $("#categoryCode").val().trim(),
            CategoryName: $("#categoryName").val().trim(),
            Description: $("#categoryDescription").val(),
            IsActive: true
        };
    } else {
        // CREATE
        data = {
            CategoryCode: $("#categoryCode").val().trim(),
            CategoryName: $("#categoryName").val().trim(),
            Description: $("#categoryDescription").val(),
            IsActive: true
        };
    }


        if (!data.CategoryCode || !data.CategoryName) {
            toastr.error("Category Code and Name required");
            return;
        }

        const url = catid
            ? "/category/update/" + catid
            : "/category/create";

        const method = catid ? "PUT" : "POST";

        $.ajax({
            url: url,
            type: method,
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function (res) {

                toastr.success(res.message);

                $("#categoryGrid").jqxGrid('updatebounddata');

                const modalEl = document.getElementById('categoryModal');
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
            },
            error: function (xhr) {

                let msg = "Save failed";

                if (xhr.responseJSON?.message)
                    msg = xhr.responseJSON.message;

                toastr.error(msg);
            }
        });

    });

    /* ---------------- ENABLE / DISABLE ---------------- */

    function toggleCategory(categoryId, isActive) {

        const action = isActive ? "disable" : "enable";

        if (!confirm(`Are you sure you want to ${action} this category?`))
            return;

        $.ajax({
            url: "/category/toggle/" + categoryId,
            type: "PUT",
            contentType: "application/json",
            data: JSON.stringify({
                IsActive: !isActive
            }),
            success: function (res) {

                toastr.success(res.message);
                $("#categoryGrid").jqxGrid('updatebounddata');
            },
            error: function () {
                toastr.error("Category update failed");
            }
        });
    }

    /* ---------------- GRID ---------------- */

    function loadCategoryGrid() {

        var source = {
            datatype: "json",
            url: "/category/all",
            datafields: [
                { name: "categoryId", type: "number" },
                { name: "categoryCode", type: "string" },
                { name: "categoryName", type: "string" },
                { name: "description", type: "string" },
                { name: "isActive", type: "bool" }
            ]
        };

        var adapter = new $.jqx.dataAdapter(source);

    window.LinkwellGrid.create("#categoryGrid", {
        width: "100%",
        autoheight: true,
        source: adapter,

        columnsresize: true,
        columnsreorder: true,
        scrollmode: "logical",

        columns: [

            {
                text: "Category Code",
                datafield: "categoryCode",
                width: "18%"
            },

            {
                text: "Category Name",
                datafield: "categoryName",
                width: "22%"
            },

            {
                text: "Description",
                datafield: "description",
                width: "30%"
            },

            {
                text: "Status",
                datafield: "isActive",
                width: "10%",
                cellsalign: "center",
                align: "center",
                cellsrenderer: function (row, col, val) {
                    return val
                        ? "<div class='status-pill active w-100 text-center'>Active</div>"
                        : "<div class='status-pill disabled w-100 text-center'>Disabled</div>";
                }
            },

            {
                text: "Actions",
                width: "20%",
                filterable: false,
                sortable: false,
                cellsalign: "center",
                cellsrenderer: function (row) {

                    const data = $("#categoryGrid")
                        .jqxGrid('getrowdata', row);

                    const toggleText = data.isActive ? "Disable" : "Enable";
                    const toggleClass = data.isActive
                        ? "btn-danger"
                        : "btn-success";

                    return `
                        <div class="d-flex justify-content-center gap-1 w-100">
                            <button class="btn btn-sm btn-outline-primary flex-fill"
                                onclick="editCategory(${row})">
                                Edit
                            </button>

                            <button class="btn btn-sm ${toggleClass} flex-fill"
                                onclick="toggleCategory(${data.categoryId}, ${data.isActive})">
                                ${toggleText}
                            </button>
                        </div>`;
                }
            }
        ]
    });

         
    }

</script>
